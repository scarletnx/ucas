# Cheap evaluation schemes, priced with the active cost model (gt1030).

# polynomials: Horner and Estrin against the naive forms
p(x: f32) = 3x^5 - 2x^4 + x^3 + 7x^2 - x + 4
scheme p
q(x: int in 0..1000) = 2x^3 + 3x^2 + 5
scheme q

# fewer multiplications: Knuth's adapted coefficients (whole ones in u32:
# the identity holds for every x), Paterson-Stockmeyer's blocks and
# splitting, and the cheapest once the model's fusions are counted
k4(x: u32) = x^4 + 7x^3 + 5x^2 + 3x + 9
scheme k4
k4e(x: u32) = x^4 + 6x^3 + 5x^2 + 3x + 9
scheme k4e
k4n(x: int in -100..100) = 2x^4 + 14x^3 - 10x^2 + 6x - 18
scheme k4n
ones(x: u32) = x^8 + x^7 + x^6 + x^5 + x^4 + x^3 + x^2 + x + 1
scheme ones
i7(x: u32) = x^7 + 3x^6 + 5x^5 + 7x^4 + 9x^3 + 11x^2 + 13x + 15
scheme i7
scheme i7 model rdna2
scheme i7 model sm75
i7n(x: u32) = 3x^7 + x^6 + 5x^5 + 7x^4 + 9x^3 + 11x^2 + 13x + 15
scheme i7n
# a sextic in floats: one root of a cubic gives the coefficients
s6(x: f32 in -1..1) = x^6 + 2x^5 - 3x^4 + x^3 + 5x^2 - x + 1
scheme s6
# a zero of the polynomial at x = -1, where no relative difference exists
s7(x: f64 in -1..1) = 2x^7 + x^6 + 2x^5 - 3x^4 + x^3 + 5x^2 - x + 1
scheme s7
d12(x: real in -1..1) = x^12 - 3x^11 + 2x^10 + x^9 - x^8 + 4x^7 + x^6 - 2x^5 + x^4 + 3x^3 - x^2 + x - 5
scheme d12

# powers by squaring
r(x: f32) = x^13
scheme r
e(x: real, n: int in 0..20) = x^n
scheme e

# loops: iteration against the closed form and the matrix power
fib[0] = 0
fib[1] = 1
fib[n] = fib[n-1] + fib[n-2]
fb(n: int in 0..90) = fib[n]
scheme fb
s(n: int in 0..1000) = sum(i, 0, n, 3i^2 + 2i + 1)
scheme s
model cheapmul : gt1030 { imul: 1 }
scheme fb model cheapmul
use cheapmul
scheme fb
use gt1030
scheme sin(x) + 1
