# exp2, log2, sqrt and inversesqrt as polynomials under a sink
# (src/fsimp.c, an_poly): each costs 4 under gt1030 (ftrans, fsqrt), a
# polynomial of degree 1 or 2 on the argument's range 2 or 3; the sink
# takes the cheapest whose certified absolute error, carried to the
# stored value with the other rewrites', stays within one step
model cheaptrans : gt1030 { ftrans: 2, fsqrt: 2 }
# exp2 on [0, 0.5], into an 8-bit target
simplify float c in [0, 1] sink unorm8 nofile
```glsl
vec3 Glow(vec3 c) { return exp2(c * 0.5) * 0.25; }
```
# log2 on [0.5, 1]: 0 at 1, so the bound is absolute only
simplify float c in [0.5, 1] sink unorm8 nofile
```glsl
float Lum(float c) { return log2(c) * 0.25 + 0.5; }
```
# sqrt fits within the step, inversesqrt (steeper on [0.25, 1]) does not
simplify float c in [0.25, 1] sink unorm8 nofile
```glsl
float Fade(float c) { return sqrt(c) * 0.5 + inversesqrt(c) * 0.25; }
```
# no sink: the polynomials are only listed
simplify float c in [0, 1] nofile
```glsl
vec3 Glow(vec3 c) { return exp2(c * 0.5) * 0.25; }
```
# where the functions cost 2, no polynomial is cheaper
simplify float c in [0, 1] sink unorm8 under cheaptrans nofile
```glsl
vec3 Glow(vec3 c) { return exp2(c * 0.5) * 0.25; }
```
use gt1030
# a polynomial already in the shader, refitted to fewer terms on its
# variable's range: the degree-4 curve takes degree 2 under an 8-bit sink
simplify float c in [0, 1] sink unorm8 nofile
```glsl
float Curve(float c) { return (((0.12 * c - 0.35) * c + 0.41) * c + 0.7) * c + 0.05; }
```
# the same per component of a vector, and expanded (its own fma gives way)
simplify float c in [0, 1] sink unorm8 nofile
```glsl
vec3 Curve3(vec3 c) { return (((0.12 * c - 0.35) * c + 0.41) * c + 0.7) * c + 0.05; }
```
simplify float c in [0, 1] sink unorm8 nofile
```glsl
float Expand(float c) { float c2 = c * c; return 0.05 + 0.7 * c + 0.41 * c2 - 0.35 * c2 * c + 0.12 * c2 * c2; }
```
# one component of a vector input: read out of it
simplify float c in [0, 1] sink unorm8 nofile
```glsl
float Comp(vec3 c) { return (((0.12 * c.y - 0.35) * c.y + 0.41) * c.y + 0.7) * c.y + 0.05; }
```
# a step of the curve also read elsewhere: kept
simplify float c in [0, 1] sink unorm8 nofile
```glsl
vec2 Two(float c) { float h = (0.12 * c - 0.35) * c + 0.41; return vec2((((h * c) + 0.7) * c + 0.05), h); }
```
# no sink: listed only
simplify float c in [0, 1] nofile
```glsl
float Curve(float c) { return (((0.12 * c - 0.35) * c + 0.41) * c + 0.7) * c + 0.05; }
```
# a product of powers as exp2 of the sum of its exponents times log2 of
# its bases: listed as an approximation without a sink (17 -> 14)
simplify float a in [0.5, 2], b in [0.25, 4] nofile
```glsl
float Spec(float a, float b) { return pow(a, 2.4) * pow(b, 0.7); }
```
# under a sink, with a divisor and an exp2 among the factors
simplify float a in [0.5, 2], b in [0.25, 4] sink unorm8 nofile
```glsl
float Ratio(float a, float b) { return pow(a, 2.4) / pow(b, 0.7) * exp2(a * 0.25); }
```
# per lane of a vector, a constant factor's log added, a scalar exponent
# splatted
simplify float c in [0.25, 1], g in [1, 4] sink unorm8 nofile
```glsl
vec3 Tone(vec3 c, float g) { return pow(c, vec3(2.2)) * pow(c, vec3(g * 0.1)) * 0.8; }
```
# a base that can be 0 has no log2: left as it is
simplify float a in [0, 2], b in [0.25, 4] sink unorm8 nofile
```glsl
float Zero(float a, float b) { return pow(a, 2.4) * pow(b, 0.7); }
```
