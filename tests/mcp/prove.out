{"jsonrpc": "2.0", "id": 0, "result": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {"listChanged": false}, "resources": {}, "prompts": {}}, "serverInfo": {"name": "ucas", "title": "ucas, a computer algebra system for programmers", "version": "1"}, "instructions": "ucas analyses functions (exhaustively on machine types), does exact algebra and calculus, transforms, number theory and finite fields, and finds cheaper implementations, each answer checked or proved.  Expressions are ucas syntax strings; give parameters types (x: u8, x: f32, x: real) where it matters.  Definitions persist across calls.  An ambiguous input is an error listing its readings: retry with args.assume.KEY.  structuredContent holds the typed result, checks and proof."}}
{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "theorem bockstein: forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C, n) and zsummand(a, H(C, n)) -> Zr(bock(C, p), r, j(bock(C, p), a)) and dzero(bock(C, p), r, j(bock(C, p), a)) and not dimg(bock(C, p), r, n - 1, j(bock(C, p), a))\n"}], "structuredContent": {"id": 1, "ok": true, "cmd": "theorem", "ucas": "theorem bockstein: forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C,n) and zsummand(a,H(C,n)) -> Zr(bock(C,p),r,j(bock(C,p),a)) and dzero(bock(C,p),r,j(bock(C,p),a)) and not dimg(bock(C,p),r,n-1,j(bock(C,p),a))", "structured": true, "result": {"kind": "theorem", "name": "bockstein", "statement": "forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C, n) and zsummand(a, H(C, n)) -> Zr(bock(C, p), r, j(bock(C, p), a)) and dzero(bock(C, p), r, j(bock(C, p), a)) and not dimg(bock(C, p), r, n - 1, j(bock(C, p), a))"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "theorem bockstein: forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C, n) and zsummand(a, H(C, n)) -> Zr(bock(C, p), r, j(bock(C, p), a)) and dzero(bock(C, p), r, j(bock(C, p), a)) and not dimg(bock(C, p), r, n - 1, j(bock(C, p), a))\n"}, "isError": false}}
