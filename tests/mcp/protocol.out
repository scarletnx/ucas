ype": "object", "properties": {"kind": {"enum": ["rule", "info", "assumed", "default"]}, "text": {"type": "string"}}}}, "conditions": {"description": "where the answer holds", "type": "array", "items": {"type": "string"}}, "checks": {"type": "array", "items": {"type": "object", "properties": {"kind": {"type": "string"}, "points": {"type": "integer"}, "max_diff": {"type": "number"}, "passed": {"type": "boolean"}, "text": {"type": "string"}}}}, "proof": {"type": "object", "properties": {"kind": {"enum": ["symbolic", "exhaustive", "sat", "numeric", "search"]}, "text": {"type": "string"}}}, "files": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "mime": {"type": "string"}, "bytes": {"type": "integer"}, "path": {"type": "string"}, "base64": {"type": "string"}}}}, "text": {"description": "the output as the CLI prints it", "type": "string"}, "error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"enum": ["bad_json", "bad_request", "unknown_command", "parse_error", "domain_error", "unsupported", "failed", "ambiguous", "needs_input", "not_understood", "timeout", "internal"]}, "message": {"type": "string"}, "pos": {"type": "object", "properties": {"line": {"type": "integer"}, "col": {"type": "integer"}}}, "key": {"description": "ambiguous: the args.assume key that picks a reading", "type": "string"}, "readings": {"type": "array", "items": {"type": "object", "properties": {"index": {"type": "integer"}, "reading": {"type": "string"}, "default": {"type": "boolean"}, "how": {"type": "string"}}}}, "how": {"type": "string"}}}}}}]}}
