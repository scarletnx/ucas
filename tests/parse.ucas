# How ambiguous math syntax is read.  Every guess prints a note.
parse 2x^2 + 3x - 1
parse 1/2x
parse -x^2
parse sin x^2 + cos 2x
parse sin x cos x
parse |x - |y||
parse a < b < c
parse x(y + 1)
parse xy + 1
parse 2pi r
parse x² + y³
parse a & b == c
parse x = 0 ? 1 : 2
1/2 + 1/3
7/2
2^10
sqrt(2)
f(n: u8) = sqrt(n)
show f
g(x) = x xor 3
show g
h = a*b + c
show h
parse (x +
show f
# ^ between integers next to bitwise operators reads as xor (asked in the bot)
f2(a: u8, b: u8) = (a ^ b) & 0x0f
show f2
g2(a: u8) = a ^ 2
show g2
h2(a: u8) = (a ** 2) & 7
show h2
# a where name is one operand: the bitwise operator in its value is not beside the comparison
wp(x: u8, y: u8) = (a >= b ? 0 : 1) where a = (x & 7), b = (y & 7)
wq(x: u8, y: u8) = (a >= b ? 0 : 1) where a = x & 7, b = y & 7
show wq
# written beside the comparison, the note stays
wr(x: u8, y: u8) = (a & 7 >= b ? 0 : 1) where a = x, b = y & 7
# integer literals go up to 2^64 - 1 (a u64 past 2^63 - 1); past it, an error that names the literal
lmax(x: u64) = x & 18446744073709551615
lbig(x: u64) = x + 18446744073709551616
lhex(x: u64) = x & 0x1_0000_0000_0000_0000
# a minus right before 2^63 is the int -2^63; before a larger u64 literal it wraps, with a note
-9223372036854775808
f64(-9223372036854775808)
-9_223_372_036_854_775_808 == -9223372036854775807 - 1
-0x8000_0000_0000_0000
-18446744073709551615
match -9223372036854775808 { -9223372036854775808 => 1, _ => 2 }
mn(x: i64 in -9223372036854775808..-9223372036854775805) = x + 1
range mn
# a range bound past 2^63 - 1 is refused on an integer parameter (it read as a negative end) and taken on a float one
ru(x: u64 in 0..0xFFFF_FFFF_FFFF_FFFF) = x >> 63
ru2(x: u64 in 0x8000_0000_0000_0000..0xFFFF_FFFF_FFFF_FFFF) = x >> 63
rf(x: f64 in 0..18446744073709551615) = x
show rf
re(x in 5..3) = x
# an error in a bare expression is said once, at its own line (#503)
1 + )
3 * * 2
