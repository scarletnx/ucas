# The model language for multiplies of narrow operands and saturating
# results (src/fuse.c): fusion inputs of a proved width, the mul16
# class, result modifiers.

# mul16: a class a model may list (unavailable otherwise), for fusions
# over inputs of a proved width.  gt1030 does not list it: not measured
m1(a: u32 in 0..60000, b: u32 in 0..60000, c: u32) = a * b + c
m2(a: u32, b: u32, c: u32) = (a & 0xffff) * (b >> 16) + c
m3(a: u32, b: u32) = a * b
m4(a: i32 in -30000..30000, b: i32 in -100..100) = a * b
m5(a: u32, b: u32) = a * b where a < 50000 && b < 1000
cost m1
model xmad : gt1030 { mul16: 1
  fuse xmad(a: u16, b: u16, c: int) = a * b + c : mul16
  fuse mul16(a: u16, b: u16) = a * b : mul16
  fuse smul16(a: s16, b: s16) = a * b : mul16 }
use xmad
cost m1
cost m2
cost m3
cost m4
cost m5
# a model derived from it has the class and the fusions; mul16: none
# takes the class away
model xmad2 : xmad { mul16: none }
use xmad2
cost m1
# dot products are priced against the cover, with the fusions: a
# product of two bytes plus c (under gt1030 a dot and an add, 2 against
# one IMAD's 3: tests/dot.ucas) stays one XMAD (1) under xmad; a
# multiply by 8 plus b is a shift-add (2), which a dot and an add do
# not beat
m6(a: u32 in 0..255, b: u32 in 0..255, c: u32) = a * b + c
use xmad
find m6 1
m7(a: u32 in 0..255, b: u32) = a * 8 + b
use gt1030
find m7 1
# the fusions without the price: the form is not available
model noprice : gt1030 { fuse xmad(a: u16, b: u16, c: int) = a * b + c : mul16 }
use noprice
cost m1
model bad : gt1030 { fuse q(a: u40) = a + 1 : 1 }

# a result modifier: the clamp to [0, 1] folded into the instruction
# that makes its input (a saturating add, multiply or fma)
model sat : gt1030 { fuse fsat(a: float) = min(max(a, 0.0), 1.0) : 0 on fadd fmul }
use sat
s1(x: f32, y: f32, z: f32) = min(max(x * y + z, 0.0), 1.0)
s2(x: f32, y: f32) = min(max(x + y, 0.0), 1.0) * 2.0
cost s1
cost s2
# not into a square root (no such class listed), nor into a value used
# elsewhere too
s3(x: f32) = min(max(sqrt(x), 0.0), 1.0)
s4(x: f32, y: f32) = { t = x * y; min(max(t, 0.0), 1.0) + t }
cost s3
cost s4
use gt1030
cost s1
model bad2 : gt1030 { fuse q(a: float) = -a : 0 in fadd on fmul }
# in a shader too (#45): the cover of simplify's SPIR-V reads each
# integer's range from its type, its constants and its operations, so a
# product of two values masked to 16 bits or shifted down by 16 is one
# XMAD under xmad; the mask and the shift stay (the input's width is
# what is proved, not that the instruction reads a half).  A product of
# full words whose low half alone is kept is not narrowed: no width is
# proved for its operands
use xmad
simplify nofile nofunctions
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = b.d[i], y = b.d[i + 64u], z = b.d[i + 128u];
    b.d[i + 192u] = (x & 0xffffu) * (y & 0xffffu) + z;
    b.d[i + 256u] = ((x * y) & 0xffffu) + z;
    b.d[i + 320u] = (x >> 16) * (y >> 16) + z;
}
```
# a model whose XMAD reads the halves itself says so with patterns: the
# masks and the shifts fold into it
model xmadh : xmad {
  fuse xmadlo(a: int, b: int, c: int) = (a & 65535) * (b & 65535) + c : mul16
  fuse xmadhi(a: int, b: int, c: int) = (a >> 16) * (b >> 16) + c : mul16 }
use xmadh
simplify nofile nofunctions
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = b.d[i], y = b.d[i + 64u], z = b.d[i + 128u];
    b.d[i + 192u] = (x & 0xffffu) * (y & 0xffffu) + z;
    b.d[i + 320u] = (x >> 16) * (y >> 16) + z;
}
```
# under gt1030, which lists no mul16, the same stays two IMADs
use gt1030
simplify nofile nofunctions
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = b.d[i], y = b.d[i + 64u], z = b.d[i + 128u];
    b.d[i + 192u] = (x & 0xffffu) * (y & 0xffffu) + z;
    b.d[i + 320u] = (x >> 16) * (y >> 16) + z;
}
```
