# An assumption on a value whose name is also an English word: the
# simplify request's translation is read as ucas, so `assume width 2 4`
# is the assumption (3DS fill.comp's push constant is `width`).
use gt1030
simplify nofile nofunctions, width in [2, 4], height in [1, 512]
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
layout(push_constant) uniform P { uint width, height; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= height) return;
  b.d[i] = (b.d[i] >> ((i & 3u) * 8u)) + (width & 7u);
}
```
