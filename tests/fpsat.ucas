# IEEE floats in the SAT path (src/fpsat.c): equiv of float formulas too
# big to enumerate is proved or refuted by SAT, not left sampled.
#
# An f32 product is the f64 product rounded once: an exact rounding folds
# away, so both sides are one circuit and no search is needed
l2a(x: f32, y: f32) = x * y
l2b(x: f32, y: f32) = f32(f64(x) * f64(y))
equiv l2a l2b
# binary16 through binary64 and back, in two parameters (2^32 points)
h1(x: f16, y: f16) = x * y
h2(x: f16, y: f16) = f16(f64(x) * f64(y))
equiv h1 h2
# ldexp by a constant: a scale by 2^k is exact in f64
ld1(x: f32) = x * f32(0.125)
ld2(x: f32) = f32(f64(x) * f64(0.125))
equiv ld1 ld2
# operands that commute make one circuit whichever comes first
c1(x: f32, y: f32) = x + y
c2(x: f32, y: f32) = y + x
equiv c1 c2
c3(x: f64, y: f64) = x * y
c4(x: f64, y: f64) = y * x
equiv c3 c4
# one pair of the 2^32 differs: the sample misses it, SAT finds it and the
# evaluator confirms it
u1(x: f16, y: f16) = x + y
u2(x: f16, y: f16) = x == f16(1) && y == f16(2^(-10)) ? x : x + y
equiv u1 u2
# a parameter's domain is the evaluator's: the finite values, -0 read as
# +0.  Every bit pattern, -0 and the NaNs too, is a u32 read by asfloat
s1(x: f32, y: f32) = copysign(f32(1), x) * y
s2(x: f32, y: f32) = (x < f32(0) ? f32(-1) : f32(1)) * y
equiv s1 s2
s3(a: u32) = copysign(f32(1), x) where x = asfloat(a), x == x
s4(a: u32) = x < f32(0) ? f32(-1) : f32(1) where x = asfloat(a), x == x
equiv s3 s4
# flush to zero is written with the operations: a product of flushed
# operands, flushed, against the same through f64
flush0(v: f32) = abs(v) < f32(2^(-126)) ? copysign(f32(0), v) : v
z1(x: f32, y: f32) = flush0(flush0(x) * flush0(y))
z2(x: f32, y: f32) = flush0(f32(f64(flush0(x)) * f64(flush0(y))))
equiv z1 z2
# ftz: every float operation (a bit cast aside) reads a subnormal as the
# zero of its sign and gives one; noftz, or nothing, keeps subnormals
# (IEEE).  x * 1 flushes a subnormal x, the select returns it as it is
n1(x: f32, y: f32) = x * y
n2(x: f32, y: f32) = y == f32(1) ? x : x * y
equiv n1 n2 noftz
equiv n1 n2 ftz
equiv l2a l2b ftz
is n1 equal to n2 with subnormals flushed to zero?
# fma rounds once: with a product of 1 it is the sum, one circuit
fa(x: f32, z: f32) = fma(x, f32(1), z)
fb(x: f32, z: f32) = x + z
equiv fa fb
# no circuit for a division yet: sampled, and it says why
d1(x: f32, y: f32) = x / y
d2(x: f32, y: f32) = (x / y) * f32(1)
equiv d1 d2
# but one by a constant power of two is the product by its reciprocal, the
# same value rounded once (#461), with subnormals flushed as well; a wrong
# scale differs
q1(x: f32, y: f32) = (x + y) / 4
q2(x: f32, y: f32) = (x + y) * 0.25
equiv q1 q2
equiv q1 q2 ftz
q3(x: f32, y: f32) = (x + y) * 0.5
equiv q1 q3
q4(x: f64, y: f64) = x / -0.125
q5(x: f64, y: f64) = -(x * 8)
equiv q4 q5
# 2^127's reciprocal is subnormal in f32: not taken
q6(x: f32, y: f32) = x / 1.7014118346046923e38
q7(x: f32, y: f32) = x * 5.877471754111438e-39
equiv q6 q7
# a 64-bit integer into f32 is rounded once (#466): 2^60 + 2^36 + 1 is
# above the midpoint of 2^60 and 2^60 + 2^37
k(x: i64) = asuint(f32(x))
k(1152921573326323713)
# integers in: i32 is exact in f64, so through it is one rounding; i64
# is not, and the two differ
i1(x: i32, y: i32) = f32(x) * f32(y)
i2(x: i32, y: i32) = f32(f64(x)) * f32(f64(y))
equiv i1 i2
j1(x: i64) = f32(x)
j2(x: i64) = f32(f64(x))
equiv j1 j2
# out: toward zero; floor and ceil
t1(x: f32) = i32(x)
t2(x: f32) = i32(x < f32(0) ? ceil(x) : floor(x))
equiv t1 t2
r1(x: f32, y: f32) = floor(x) + floor(y)
r2(x: f32, y: f32) = -ceil(-x) + -ceil(-y)
equiv r1 r2
# nanbits: two NaN results are equal only with the same sign and payload.
# q1 and q2 differ only in a NaN's payload, q3 and q2 only in its sign:
# equal without nanbits, a counterexample with it
q1(x: u32) = asfloat(x | 0x7fc00000)
q2(x: u32) = asfloat(u32(0x7fc00000))
q3(x: u32) = asfloat((x & 0x80000000) | 0x7fc00000)
equiv q1 q2
equiv q1 q2 nanbits
equiv q3 q2
equiv q3 q2 nanbits
# f16 and f64 keep a NaN's payload too (f16: every point enumerated)
hn1(x: u16) = asfloat(x | 0x7e00)
hn2(x: u16) = asfloat(u16(0x7e00))
equiv hn1 hn2
equiv hn1 hn2 nanbits
d64a(x: u64) = asfloat(x | 0x7ff8000000000000)
d64b(x: u64) = asfloat(u64(0x7ff8000000000000))
equiv d64a d64b nanbits
# a payload that only moves is proved bit for bit: a double negation, abs
# against the cleared sign bit, a select of two NaNs
m1(x: u32) = -(-asfloat(x))
m2(x: u32) = asfloat(x)
equiv m1 m2 nanbits
a1(x: u32) = abs(asfloat(x))
a2(x: u32) = asfloat(x & 0x7fffffff)
equiv a1 a2 nanbits
sel1(x: u32, y: u32) = x < y ? asfloat(x | 0x7f800001) : asfloat(y | 0x7f800001)
sel2(x: u32, y: u32) = asfloat((x < y ? x : y) | 0x7f800001)
equiv sel1 sel2 nanbits
# one payload out of 2^22 differs: beyond the sample, found by SAT
p1(x: u32) = asfloat(x | 0x7fc00000)
p2(x: u32) = (x & 0x3fffff) == 0x25a5a5 ? asfloat(u32(0x7fc00000)) : asfloat(x | 0x7fc00000)
equiv p1 p2
equiv p1 p2 nanbits
# a NaN that arithmetic makes has a free payload in the circuit: x + 0
# keeps x's on the host, which the circuit does not prove
ar1(x: u32) = asfloat(x) + f32(0)
equiv ar1 m2 nanbits
# ftz and nanbits in either order; nanbits on an integer result has
# nothing to compare, and says so
equiv q1 q2 nanbits ftz
ib1(x: u32) = asuint(asfloat(x | 0x7fc00000))
ib2(x: u32) = x | 0x7fc00000
equiv ib1 ib2 nanbits
is q1 equal to q2 comparing NaN payloads?
