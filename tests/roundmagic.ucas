# The rounding analysis where the bits read are those of a computed
# value (src/rounderr.c): a rounding to an integer written as an add,
# the other side of a step choice, a float with error scaled through its
# exponent or with its sign bit changed.

# x + 1.5 2^23 is that constant plus x rounded to the nearest integer,
# ties to even, exactly (while |x| <= 2^22): not an error of u, a choice
# at the half integers; less the constant again it is the integer.  One
# operation rounds here, the product; at x = 25 it is within its error
# of 2.5 and the other side is 2, not 3
rn(x: f32 in 15..25) = (x * 0.1 + 12582912.0) - 12582912.0
error rn ~ roundeven(x * 0.1)
# the same for an f64, its constant 1.5 2^52
rn64(x: f64 in 15..25) = (x * 0.1 + 6755399441055744.0) - 6755399441055744.0
error rn64 ~ roundeven(x * 0.1)

# a reduction 2^k P(r), r = x - k ln 2, k from the rounding add and 2^k
# from its bits: where k can go the other way (x = 0.34657359, x c at
# 0.5, the last float of the range) 2^k doubles and r takes it back, so the other side is what the
# two reductions differ by (this short P: about 1.4%), run again from
# the choice on, not a step of 1 times a slope
ex2(x: f32 in 0.1..0.3465736) = { j = x * 1.44269502 + 12582912.0; k = j - 12582912.0; r = x - k * 0.693147182; (1 + r + 0.5 * r * r) * asfloat((asuint(j) << 23) + 0x3f800000) }
error ex2 ~ exp(x)

# a float with error scaled by an add to its exponent field: its bits
# are linear in it, one unit an ulp, and come back as the float times 8
sc(x: f32 in 1..2) = asfloat(asuint(x * 1.1) + (3 << 23))
error sc ~ 8 * (x * 1.1)
# its sign bit flipped, and set by the sign of another value's bits
ng(x: f32 in 1..2) = asfloat(asuint(x * 1.1) xor 0x80000000)
error ng ~ -(x * 1.1)
cs(x: f32 in 1..2, y: f32 in -1..1) = asfloat(asuint(x * 1.1) | (asuint(y) & 0x80000000))
error cs ~ copysign(x * 1.1, y)

# shifted right or masked, those bits step: at each multiple of 2^k for
# a shift by k, of 2^t for a mask with t trailing ones (which the result
# follows between the steps), of the mask's lowest bit when it has none.
# Within their error of a step the worst case adds what the far end of
# that error gives.  Every f32 x in 1..2 run against the exact product's
# bits (work/roundbits/shmask.c): sh 1.447 u at most, mk 8192 u
# (at x = 1.819, x * 1.1 just past 2; the sample's worst is a little less)
sh(x: f32 in 1..2) = asfloat(0x5f3759df - (asuint(x * 1.1) >> 1))
error sh ~ 1 / sqrt(x * 1.1)
mk(x: f32 in 1..2) = asfloat(asuint(x * 1.1) & 0xfffff000)
error mk ~ x * 1.1
# the exponent of a computed value, as a float: exact but where x * 1.1
# is within its error of a power of two
ex(x: f32 in 1..1000) = f32(i32((asuint(x * 1.1) >> 23) & 255) - 127)
error ex ~ floor(log(x * 1.1) / log(2))
# its mantissa in 1..2: the low 23 bits follow it, the exponent or-ed in
# touches none of them (an add), and at a power of two it steps
mt(x: f32 in 1..4) = asfloat((asuint(x * 1.1) & 0x7fffff) | 0x3f800000)
error mt ~ x * 1.1 / 2 ^ floor(log(x * 1.1) / log(2))
# an f16's bits the same way: its sign cleared, its mantissa in 1..2
a16(x: f16 in -2..-1) = asfloat(asuint(x * 1.1) & 0x7fff)
error a16 ~ abs(x * 1.1)
m16(x: f16 in 1..4) = asfloat((asuint(x * 1.1) & 0x3ff) | 0x3c00)
error m16 ~ x * 1.1 / 2 ^ floor(log(x * 1.1) / log(2))
# not analysed, and said: or-ed with a constant in bits they have, two
# such values combined
orb(x: f32 in 1..2) = asfloat(asuint(x * 1.1) | 0x1000)
error orb ~ x * 1.1
two(x: f32 in 1..2) = asfloat(asuint(x * 1.1) + asuint(x * 1.3))
error two ~ x
