# Subgroup forms that need the subgroup's size fixed and every lane
# active (pipeline state a module cannot say): simplify proposes them
# with that change spelled out and leaves the module as it is.
#
# Under gt1030 (warp 32; the scan 60.25, a shuffle up 5, a compare
# 2.375, a select 1.625, an add 1): a scan of any value as a ladder of
# five shuffles, the exclusive one less the lane's own value; a constant
# table of 8 entries read three times as a register of the subgroup
simplify nofile nofunctions under gt1030
```glsl
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 32) in;
layout(std430, binding = 0) buffer B { uint d[64]; } b;
const uint T[8] = uint[](3u, 1u, 4u, 1u, 5u, 9u, 2u, 6u);
void main() {
  uint i = gl_GlobalInvocationID.x;
  uint x = b.d[i];
  uint s = subgroupInclusiveAdd(x);
  uint e = subgroupExclusiveAdd(x * 3u);
  b.d[i] = s + e + T[x & 7u] + T[(x >> 3) & 7u] + T[(x >> 6) & 7u];
}
```
# a table read once costs less as a load: nothing proposed for it
simplify nofile nofunctions under gt1030
```glsl
#version 450
layout(local_size_x = 32) in;
layout(std430, binding = 0) buffer B { uint d[64]; } b;
const uint T[8] = uint[](3u, 1u, 4u, 1u, 5u, 9u, 2u, 6u);
void main() {
  uint i = gl_GlobalInvocationID.x;
  b.d[i] = T[b.d[i] & 7u];
}
```
