# f16 is IEEE binary16: 11 significant bits, subnormals down to 2^-24, inf
# from 65520 up.  Small enough that one parameter is every value.
id(x: f16) = x
range id

# bits: asuint(asfloat(b)) is b for every pattern (NaNs and their payloads
# too), and back
bits(b: u16) = asuint(asfloat(b))
same(b: u16) = b
equiv bits same
back(x: f16) = asfloat(asuint(x))
equiv back id
show asuint(f16(1))
show asuint(f16(-0.0))
show asfloat(u16(0x7c00))
# sqrt of a negative is NaN, a value: its bits less the sign
nanbits(x: f16 in -4..-1) = asuint(sqrt(x)) & 0x7fff
range nanbits

# the subnormals are the multiples of 2^-24
sub(n: u16 in 0..1023) = real(asfloat(n)) * 16777216
subn(n: u16 in 0..1023) = real(n)
equiv sub subn
show asuint(f16(2.9802322387695312e-08))
show asuint(f16(2.9802322387695316e-08))

# an integer rounds to 11 bits, ties to even, written here in integers
r11(k: u32 in 0..65519) = k < 2048 ? k : (q + (rem > half || (rem == half && (q & 1) == 1) ? 1 : 0)) << e
  where e = 21 - clz(k), q = k >> e, rem = k & ((1 << e) - 1), half = 1 << (e - 1)
cast(k: u32 in 0..65519) = u32(f16(k))
equiv cast r11
show f16(2049)
show f16(2051)
show f16(65519)
show f16(65520)
show f16(0.1)

# + - * / sqrt round once, and say where inf and NaN first appear
third(x: f16 in 1..2) = x / 3
wrap third
twice(x: f16 in 32000..65504) = x * 2
wrap twice
root(x: f16 in -1..1) = sqrt(x)
wrap root
# 65504 + 16 is the midpoint to 2^16: it ties to the even one, inf
top(x: f16 in 65472..65504) = x + 16
wrap top
range top

# fma rounds once: a * b + c in integers, rounded as above.  The product
# rounded first is another function
exact(a: u32 in 0..255, b: u32 in 0..255, c: u32 in 0..63) = r11(a * b + c)
fused(a: u32 in 0..255, b: u32 in 0..255, c: u32 in 0..63) = u32(fma(f16(a), f16(b), f16(c)))
equiv fused exact
twostep(a: u32 in 0..255, b: u32 in 0..255, c: u32 in 0..63) = u32(f16(a) * f16(b) + f16(c))
equiv twostep exact

# a float trick for an integer division, proved on every input: x / 3 for
# a byte as a multiply and a floor.  1/3 rounded to f16 is below 1/3; the
# product's own rounding makes up for it (3 * 1365/4096 ties up to 1), which
# the same constant on the real line does not
div3(x: u8) = x / 3
mul3(x: u8) = u8(floor(f16(x) * f16(1 / 3)))
equiv mul3 div3
ideal3(x: u8) = u8(floor(real(x) * real(f16(1 / 3))))
equiv ideal3 div3

# the wider float wins
mix(x: f16, y: f32) = x + y
show mix

# approx has no f16 format, and says so
approx third
