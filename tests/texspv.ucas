# A constant table read in a SPIR-V module through the texture unit
# (#103): the table's index is an address mode of a subterm i (proved by
# SAT where the read is defined: 0 <= index < n), |i| within the reach of
# an f32 coordinate (proved by SAT), and the read cheaper as a conversion,
# an add, a multiply and a nearest read.  `texture set S binding B` (the
# descriptor the host binds the table's texture at) writes it; without
# it the read is proposed.
model cal : gt1030 { tex_nearest: 5, tex_within: 2, sremk: 21 }
# proposed: REPEAT, i = v & 0xffff
simplify nofile nofunctions under cal
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
const uint K[7] = uint[](10u, 20u, 30u, 40u, 50u, 60u, 70u);
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint v = b.d[i];
    b.d[i] = K[(v & 0xFFFFu) % 7u];
}
```
