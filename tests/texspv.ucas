# a signed table and MIRROR (min(i % 14, 13 - i % 14) on an int; cal
# prices the signed remainder by a constant, which gt1030 leaves out), and
# a second table: one binding is one texture, the other read is proposed
simplify nofile nofunctions under cal texture set 1 binding 0
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { int d[]; } b;
const int S[7] = int[](-3, -2, -1, 0, 1, 2, 3);
const int T[5] = int[](100, 200, 300, 400, 500);
void main() {
    uint i = gl_GlobalInvocationID.x;
    int v = b.d[i] >> 12;
    int r = v % 14;
    uint w = uint(b.d[i + 64u]);
    b.d[i] = S[min(r, 13 - r)] + T[(w & 0xFFFFu) % 5u];
}
```
