# 3. identities in derivative results
wronskian sinh(x), cosh(x)
wronskian sin x, cos x
wronskian exp(x)*sin(x), exp(x)*cos(x)
jacobian x*cos(y), x*sin(y) wrt x, y
k(x, y) = log(cosh(x)*cos(y))
hessian k
laplacian k
diff log(cosh(x)) x 2
# 4. approx and properties of asin acos ... atanh
approx asinh(x) in -1..1 list 3
approx tanh(x) in -3..3 ulp 2 list 3
approx acos(x) in -0.9..0.9 list 2
approx atanh(x) in -0.5..0.5 list 2
approx cosh(x) in -3..3 ulp 1 list 2
taylor tanh(x) order 7
parity asinh(x) + atanh(x/2)
identify tanh(x)
g(x: f32 in -0.9..0.9) = acos(x) + tanh(x)
cost g
wrap g
range acos(x)
domain atanh(x)
# 5. plot bounds
plot3d x^2 - y^2 nofile
plot x*y + z parallel nofile
plot log(x) logx nofile
plot x^2 logx nofile
h(n: u8 in 0..20) = n*n
plot h nofile
# crit: an f32 rounding plateau is one point
ch(x: f32 in -0.9..0.9) = sin(x) - x
crit ch
cp(x: f32 in -3..3) = x^3 - 3x
crit cp
