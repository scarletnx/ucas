/* isqrt4, basis c: bits are independent lanes, so the same code also
   runs bit-sliced on whole words */
static inline uint32_t
isqrt4_gates(uint32_t x)
{
	uint32_t x0 = x >> 0 & 1;
	uint32_t x1 = x >> 1 & 1;
	uint32_t x2 = x >> 2 & 1;
	uint32_t x3 = x >> 3 & 1;
	uint32_t t0 = x0 | x1;
	uint32_t t1 = x2 | x3;
	uint32_t t2 = x2 | t0;
	uint32_t t3 = x3 ^ t1;
	uint32_t t4 = t2 ^ t3;
	return (t4 & 1) << 0 | (t1 & 1) << 1;
}
