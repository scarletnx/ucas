# Exact abstract algebra (absalg.h): integers of any size, integer
# matrices with certified normal forms, finitely generated abelian groups

# integers: no wrapping, ever
bigint 2^200 + 1
bigint 100! / 98!
bigint (2^127 - 1) * (2^89 - 1) - 2^216
bigint -7 div 2
bigint -7 % 2
bigint gcd(2^120 - 1, 2^90 - 1)
bigint factor 2^64 + 1
bigint factor 2^200 + 1
bigint factor 600851475143 * 1000000007^2
bigint isprime(2^127 - 1)

# Smith and Hermite normal forms with their unimodular transforms
snf [[2, 4, 4], [-6, 6, 12], [10, -4, -16]]
snf [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
snf [[6, 0], [0, 4], [0, 0]]
snf [[123456789012345678901234567890, 2], [3, 987654321098765432109876543210]]
snf [[2^62, 2^62 + 1], [2^63, 2^63 + 1]]
hnf [[2, 4, 4], [-6, 6, 12], [10, -4, -16]]
hnf [[0, 3, 6], [0, 2, 4], [1, 1, 1]]

# kernels, images, solving over Z (and over Q when Z has no solution)
zmat [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
zmat kernel [[2, 4, 6, 8], [1, 3, 5, 7]]
zmat image [[2, 4], [4, 2]]
zmat solve [[2, 0], [0, 3]], [4, 9]
zmat solve [[2, 0], [0, 3]], [3, 9]
zmat solve [[1, 1, 1], [1, 2, 3]], [6, 14]
zmat det [[123456789012345678901, 2], [3, 4]]
zmat inverse [[2, 3], [1, 2]]
zmat inverse [[2, 0], [0, 1]]
zmat cokernel [[2, 0], [0, 0]]
qmat inverse [[1/2, 1], [3, 4]]
qmat rref [[1, 2, 3], [2, 4, 7]]
qmat solve [[1, 2], [3, 4]], [1/2, 1/3]

# finitely generated abelian groups
abgroup Z/4 + Z/6
abgroup Z/2^3 + (Z/3)^2 + Z^2
abgroup coker [[2, 4, 4], [-6, 6, 12], [10, -4, -16]]
abgroup [[0]]
abgroup 0
abiso Z/4 + Z/6, Z/2 + Z/12
abiso Z/4 + Z/4, Z/2 + Z/8
abiso Z/6 + Z/10 + Z/15, Z/30 + Z/30
abhom Z/4 + Z/6, Z/2 + Z/12
abhom Z^2 + Z/3, Z/6
abtensor Z/4 + Z, Z/6
abtor Z/4, Z/6
abtor Z/12 + Z, Z/8 + Z/3
abext Z/4 + Z, Z
abext Z/12, Z/8
abmap Z/12 -> Z/4 by [[1]]
abmap Z -> Z by [[4]]
abmap Z/4 -> Z/6 by [[1]]
abmap Z^2 -> Z/2 + Z/3 by [[1, 1], [1, 2]]
abelem Z/4 + Z/6, [1, 1]
abelem Z + Z/6, [0, 3]
abelem Z + Z/6, [2, 3]
absub Z/4 + Z/6, [2, 0], [0, 3]
absub Z^2, [2, 0], [0, 3]
abexact Z -> Z -> Z/4 by [[4]], [[1]]
abexact Z -> Z -> Z/4 by [[2]], [[1]]
abexact Z/2 -> Z/4 -> Z/2 by [[2]], [[1]]
abexact 0 -> Z/6 -> Z/2 + Z/3 by [], [[1], [1]]

# random groups and maps: Hom/tensor/Tor/Ext formulas, exactness, isomorphisms
abselftest 500

# permutation groups (Schreier-Sims) and Cayley tables
permgroup S4
permgroup A5
permgroup D8
permgroup (1 2)(3 4), (1 3)(2 4)
permgroup (1 2 3 4 5 6 7 8), (1 3)
permgroup S30
permgroup (1 3 8 6)(2 5 7 4)(9 33 25 17)(10 34 26 18)(11 35 27 19), (9 11 16 14)(10 13 15 12)(1 17 41 40)(4 20 44 37)(6 22 46 35), (17 19 24 22)(18 21 23 20)(6 25 43 16)(7 28 42 13)(8 30 41 11), (25 27 32 30)(26 29 31 28)(3 38 43 19)(5 36 45 21)(8 33 48 24), (33 35 40 38)(34 37 39 36)(3 9 46 32)(2 12 47 29)(1 14 48 27), (41 43 48 46)(42 45 47 44)(14 22 30 38)(15 23 31 39)(16 24 32 40)
permelem S4, (1 2 3)
permelem A5, (1 2)
permelem A5, (1 2)(3 4)
permsub (1 2)(3 4), (1 3)(2 4) in S4
permsub (1 2 3) in S4
permsub (1 2) in A4
permhom S3 -> C2 by (), (1 2)
permhom S3 -> C2 by (1 2), (1 2)
cayley [[0, 1, 2, 3], [1, 0, 3, 2], [2, 3, 0, 1], [3, 2, 1, 0]]
cayley [[0, 1, 2], [1, 2, 0], [2, 0, 1]]
cayley [[0, 1], [0, 1]]
cayley [[0, 1, 2], [1, 0, 2], [2, 2, 0]]

# polynomial ideals: Groebner bases with cofactors, membership certificates
groebner x^2 + y^2 - 1, x - y
groebner x^2 + y^2 - 1, x - y order lex
groebner x + y + z, x*y + y*z + z*x, x*y*z - 1 order lex
groebner a + b + c + d, a*b + b*c + c*d + d*a, a*b*c + b*c*d + c*d*a + d*a*b, a*b*c*d - 1
groebner x^3 - 2x*y, x^2*y - 2y^2 + x order grlex
groebner x*y - 1, y^2 - 1 mod 7
groebner y - x^2, z - x^3 order lex vars z, y, x
idealmember x^3 - 1 in x + y + z, x*y + y*z + z*x, x*y*z - 1
idealmember x^3 - x in x^2 + y^2 - 1, x - y
idealmember x^4 - 1 in x^2 - 1 mod 5
idealmember 2^100*x - 1 in 2x - 1
idealeq x^2 - 1, x - 1 = x - 1
idealeq x^2, y = x*y, y
idealeq x + y, x - y = x, y

# modules over the PID F[x]: Smith form, rational canonical form
fxmodule [[2, 1, 0], [0, 2, 0], [0, 0, 2]]
fxmodule [[0, -1], [1, 0]]
fxmodule [[0, -1], [1, 0]] mod 5
fxmodule [[1/2, 1], [0, 1/2]]
pmsnf [[x, 1], [0, x]]
pmsnf [[x^2 - 1, 0], [0, x - 1]]
pmsnf [[x, x + 1], [x^2, x^2 + x]] mod 3

# a few English phrasings
is A5 solvable?
is S4 a solvable group?
is Z/4 + Z/6 isomorphic to Z/2 + Z/12?
what is the smith normal form of [[2, 4], [6, 8]]
groebner basis of x^2 + y^2 - 1, x - y
is x^3 - 1 in the ideal generated by x + y + z, x*y + y*z + z*x, x*y*z - 1?
tensor product of Z/4 and Z/6
order of S5
