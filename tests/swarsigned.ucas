# Packed signed lanes in a u32 (src/swar.c): the lane operations whose
# result depends on the lanes' signs, found from a function's values and
# proved equal on the whole domain (tests/swar.ucas for unsigned lanes).
# max, min, |a - b| of signed bytes and halves: the mask from a compare whose
# top-bit term reads the signs
smax8(a: u32, b: u32) = (u32(max((i32(a << 24) >> 24), (i32(b << 24) >> 24))) & 255) | (u32(max((i32(a << 16) >> 24), (i32(b << 16) >> 24))) & 255) << 8 | (u32(max((i32(a << 8) >> 24), (i32(b << 8) >> 24))) & 255) << 16 | (u32(max((i32(a) >> 24), (i32(b) >> 24))) & 255) << 24
find smax8 1
smin16(a: u32, b: u32) = (u32(min((i32(a << 16) >> 16), (i32(b << 16) >> 16))) & 65535) | (u32(min((i32(a) >> 16), (i32(b) >> 16))) & 65535) << 16
find smin16 1
sabsd8(a: u32, b: u32) = (u32((max((i32(a << 24) >> 24), (i32(b << 24) >> 24)) - min((i32(a << 24) >> 24), (i32(b << 24) >> 24)))) & 255) | (u32((max((i32(a << 16) >> 24), (i32(b << 16) >> 24)) - min((i32(a << 16) >> 24), (i32(b << 16) >> 24)))) & 255) << 8 | (u32((max((i32(a << 8) >> 24), (i32(b << 8) >> 24)) - min((i32(a << 8) >> 24), (i32(b << 8) >> 24)))) & 255) << 16 | (u32((max((i32(a) >> 24), (i32(b) >> 24)) - min((i32(a) >> 24), (i32(b) >> 24)))) & 255) << 24
find sabsd8 1
# the averages on the lanes with their top bits flipped, flipped back
savg8(a: u32, b: u32) = (u32((((i32(a << 24) >> 24) + (i32(b << 24) >> 24)) >> 1)) & 255) | (u32((((i32(a << 16) >> 24) + (i32(b << 16) >> 24)) >> 1)) & 255) << 8 | (u32((((i32(a << 8) >> 24) + (i32(b << 8) >> 24)) >> 1)) & 255) << 16 | (u32((((i32(a) >> 24) + (i32(b) >> 24)) >> 1)) & 255) << 24
find savg8 1
savgc16(a: u32, b: u32) = (u32((((i32(a << 16) >> 16) + (i32(b << 16) >> 16) + 1) >> 1)) & 65535) | (u32((((i32(a) >> 16) + (i32(b) >> 16) + 1) >> 1)) & 65535) << 16
find savgc16 1
# order compares as masks of whole lanes
sgt8(a: u32, b: u32) = (u32(((i32(a << 24) >> 24) > (i32(b << 24) >> 24) ? -1 : 0)) & 255) | (u32(((i32(a << 16) >> 24) > (i32(b << 16) >> 24) ? -1 : 0)) & 255) << 8 | (u32(((i32(a << 8) >> 24) > (i32(b << 8) >> 24) ? -1 : 0)) & 255) << 16 | (u32(((i32(a) >> 24) > (i32(b) >> 24) ? -1 : 0)) & 255) << 24
find sgt8 1
sge4(a: u32, b: u32) = (u32(((i32(a << 28) >> 28) >= (i32(b << 28) >> 28) ? -1 : 0)) & 15) | (u32(((i32(a << 24) >> 28) >= (i32(b << 24) >> 28) ? -1 : 0)) & 15) << 4 | (u32(((i32(a << 20) >> 28) >= (i32(b << 20) >> 28) ? -1 : 0)) & 15) << 8 | (u32(((i32(a << 16) >> 28) >= (i32(b << 16) >> 28) ? -1 : 0)) & 15) << 12 | (u32(((i32(a << 12) >> 28) >= (i32(b << 12) >> 28) ? -1 : 0)) & 15) << 16 | (u32(((i32(a << 8) >> 28) >= (i32(b << 8) >> 28) ? -1 : 0)) & 15) << 20 | (u32(((i32(a << 4) >> 28) >= (i32(b << 4) >> 28) ? -1 : 0)) & 15) << 24 | (u32(((i32(a) >> 28) >= (i32(b) >> 28) ? -1 : 0)) & 15) << 28
find sge4 1
# in some lanes only: the top byte kept from a
smaxrgb(a: u32, b: u32) = (u32(max((i32(a << 24) >> 24), (i32(b << 24) >> 24))) & 255) | (u32(max((i32(a << 16) >> 24), (i32(b << 16) >> 24))) & 255) << 8 | (u32(max((i32(a << 8) >> 24), (i32(b << 8) >> 24))) & 255) << 16 | (a & 4278190080)
find smaxrgb 1
# add, subtract and == do not depend on the signs: the unsigned forms
seq8(a: u32, b: u32) = (u32(((i32(a << 24) >> 24) == (i32(b << 24) >> 24) ? -1 : 0)) & 255) | (u32(((i32(a << 16) >> 24) == (i32(b << 16) >> 24) ? -1 : 0)) & 255) << 8 | (u32(((i32(a << 8) >> 24) == (i32(b << 8) >> 24) ? -1 : 0)) & 255) << 16 | (u32(((i32(a) >> 24) == (i32(b) >> 24) ? -1 : 0)) & 255) << 24
find seq8 1
