# 4. a loop is priced as its trip count times the body plus the overhead;
# loop-invariant subterms are hoisted
quant(v: i32 in 0..255) = {
  best = 0; berr = 100000
  q0 = (v * 31 + 127) / 255
  for d in -2..2 {
    q = q0 + d
    qc = q < 0 ? 0 : q > 31 ? 31 : q
    r = (qc << 3) | (qc >> 2)
    e = (r - v) * (r - v)
    if e < berr { berr = e; best = qc }
  }
  best
}
cost quant
# bounds from the parameters: the worst case and the average
tri(n: u32 in 0..1000, k: u32 in 1..4) = { s: u32 = 0; for i in 1..n/k { s += i*i }; s }
cost tri
# a while loop's trip count is measured on the domain
lg(n: int in 1..1000) = { x = n; k = 0; while x > 1 { x = x / 2; k += 1 }; k }
cost lg

# 5. range proves bounds by monotonicity, the where clause's relations and
# exact integer-quotient algebra; when they meet the sample, it is exact
t64(t: int in 0..260100, dd: int in 1..260100) = (t*64 + dd/2)/dd where t <= dd
range t64
a4(t: u32 in 0..65535, d: u32 in 1..65535) = (t * 255 + d / 2) / d where t <= d
range a4
sq(x: int in 0..100000, y: int in 0..100000) = x*x - y where y <= x
range sq
r2(x: real in 1..4, y: real in 0..2) = sqrt(x) + exp(-y) * x
range r2

# 6. find splits on a parameter with few values and fits (x*K + C) >> S
# per case; K as a function of the case, or one constant per case
wref(i: u32 in 0..15, ib: u32 in 2..4) = (i * 64 + ((1 << ib) - 1) / 2) / ((1 << ib) - 1) where i < 1 << ib
find wref 5
dv(x: u32 in 0..1000, d: u32 in 1..6) = x / d
find dv 1
# signed, with the dropped operations listed first (at most 6, then the fixpoint)
find qb 1
