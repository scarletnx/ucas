# Found while optimising a BC7 encoder with ucas (stress test 1).

# 1. equiv on machine integers: the where clause narrows the enumeration
# (v < 1 << n with n <= 8 gives v <= 255: 1024 points, not 2^32 * 4)
widen(v: u32, n: u32 in 5..8) = n == 8 ? v : ((v << (8 - n)) | (v >> (2*n - 8))) & 0xFF where v < 1 << n
widen2(v: u32, n: u32 in 5..8) = ((v << (8 - n)) | (v >> (2*n - 8))) & 0xFF where v < 1 << n
equiv widen widen2

# too big to enumerate: bit-blasted and proved by SAT, or a counterexample
# found by SAT and re-checked by the evaluator
w16(v: u32, n: u32 in 5..8) = ((v << (8 - n)) | (v >> (2*n - 8))) & 0xFFFF where v < 1 << (n + 16)
w16b(v: u32, n: u32 in 5..8) = ((v << (8 - n)) & 0xFFFF) | ((v >> (2*n - 8)) & 0xFFFF) where v < 1 << (n + 16)
equiv w16 w16b
w16c(v: u32, n: u32 in 5..8) = ((v << (8 - n)) & 0xFFFF) | (v >> (2*n - 8)) where v < 1 << (n + 16)
equiv w16 w16c
needle(x: u32) = x == 123456789 ? 1 : 0
zero(x: u32) = 0
equiv needle zero
# definedness: g undefined where f is defined is a difference; the other
# way round is not (f's undefined points are outside its domain)
q(x: i32, y: i32) = x / y
q0(x: i32, y: i32) = y == 0 ? 7 : x / y
equiv q q0
equiv q0 q
# shifts by the width or more are undefined
sh(x: u32, n: u32 in 0..31) = (x << n) >> n
sh2(x: u32, n: u32 in 0..31) = x & (0xFFFFFFFF >> n)
equiv sh sh2
# loops with constant bounds are unrolled
s1(x: i32) = { s: i32 = 0; for i in 0..3 { s += x << i }; s }
s3(x: i32) = (x << 4) - x
equiv s1 s3
# a table index, clz and popcount
t1(x: u32, y: u32) = [3, 5, x, y][x & 3]
t2(x: u32, y: u32) = (x & 3) == 0 ? 3 : (x & 3) == 1 ? 5 : (x & 3) == 2 ? x : y
equiv t1 t2
# a multiplier against a commuted one is hard for SAT: it gives up and says so
m1(x: u32, y: u32) = x * y
m2(x: u32, y: u32) = y * x
equiv m1 m2

# 2. find tries dropping operations of the function itself: the & 0xFF is
# dead (the result is below 256 already)
wb(v: u8, n: u8 in 5..8) = ((u32(v) << (8 - n)) | (u32(v) >> (2*n - 8))) & 0xFF where v < 1 << n
find wb
# clamps that never bite, dropped one after another (a fixpoint)
cl(x: u8, s: u8 in 0..3) = min(max(u32(x) >> s, 0), 255) & 0xFF
find cl 1
# a ?: whose condition always holds; proved by SAT on a sampled domain
big(x: u32, n: u32 in 1..4) = n > 0 ? min((x >> 28) << n, 1000) & 0xFFFF : 7
find big 1

# 3. reports name shared subterms (the source's names where it has them)
# and cap long expressions and lists
qb(v: i32 in 0..255, b: i32 in 4..7) = {
  m = (1 << b) - 1
  q = (v * m + 127) / 255
  up = q < m ? q + 1 : q
  dn = q > 0 ? q - 1 : q
  rq = (q << (8 - b)) | (q >> (2*b - 8))
  ru = (up << (8 - b)) | (up >> (2*b - 8))
  rd = (dn << (8 - b)) | (dn >> (2*b - 8))
  eq = (rq - v) * (rq - v)
  eu = (ru - v) * (ru - v)
  ed = (rd - v) * (rd - v)
  eu < eq && eu <= ed ? up : ed < eq ? dn : q
}
show qb
cost qb
# a very long body is cut, with the number of characters left out
big(x: u32) = (x xor 1)*4 + (x xor 2)*5 + (x xor 3)*6 + (x xor 4)*7 + (x xor 5)*8 + (x xor 6)*9 + (x xor 7)*10 + (x xor 8)*11 + (x xor 9)*12 + (x xor 10)*13 + (x xor 11)*14 + (x xor 12)*15 + (x xor 13)*16 + (x xor 14)*17 + (x xor 15)*18 + (x xor 16)*19 + (x xor 17)*20 + (x xor 18)*21 + (x xor 19)*22 + (x xor 20)*23 + (x xor 21)*24 + (x xor 22)*25 + (x xor 23)*26 + (x xor 24)*27 + (x xor 25)*28 + (x xor 26)*29 + (x xor 27)*30 + (x xor 28)*31 + (x xor 29)*32 + (x xor 30)*33 + (x xor 31)*34 + (x xor 32)*35 + (x xor 33)*36 + (x xor 34)*37 + (x xor 35)*38 + (x xor 36)*39 + (x xor 37)*40 + (x xor 38)*41 + (x xor 39)*42 + (x xor 40)*43 + (x xor 41)*44 + (x xor 42)*45 + (x xor 43)*46 + (x xor 44)*47 + (x xor 45)*48 + (x xor 46)*49 + (x xor 47)*50 + (x xor 48)*51 + (x xor 49)*52 + (x xor 50)*53 + (x xor 51)*54 + (x xor 52)*55 + (x xor 53)*56 + (x xor 54)*57 + (x xor 55)*58 + (x xor 56)*59 + (x xor 57)*60 + (x xor 58)*61 + (x xor 59)*62 + (x xor 60)*63 + (x xor 61)*64 + (x xor 62)*65 + (x xor 63)*66 + (x xor 64)*67 + (x xor 65)*68 + (x xor 66)*69 + (x xor 67)*70 + (x xor 68)*71 + (x xor 69)*72 + (x xor 70)*73 + (x xor 71)*74 + (x xor 72)*75 + (x xor 73)*76 + (x xor 74)*77 + (x xor 75)*78 + (x xor 76)*79 + (x xor 77)*80 + (x xor 78)*81 + (x xor 79)*82 + (x xor 80)*83 + (x xor 81)*84 + (x xor 82)*85 + (x xor 83)*86 + (x xor 84)*87 + (x xor 85)*88 + (x xor 86)*89 + (x xor 87)*90 + (x xor 88)*91 + (x xor 89)*92 + (x xor 90)*93 + (x xor 91)*94 + (x xor 92)*95 + (x xor 93)*96 + (x xor 94)*97 + (x xor 95)*98 + (x xor 96)*99 + (x xor 97)*100 + (x xor 98)*101 + (x xor 99)*102 + (x xor 100)*103 + (x xor 101)*104 + (x xor 102)*105 + (x xor 103)*106 + (x xor 104)*107 + (x xor 105)*108 + (x xor 106)*109 + (x xor 107)*110 + (x xor 108)*111 + (x xor 109)*112 + (x xor 110)*113 + (x xor 111)*114 + (x xor 112)*115 + (x xor 113)*116 + (x xor 114)*117 + (x xor 115)*118 + (x xor 116)*119 + (x xor 117)*120 + (x xor 118)*121 + (x xor 119)*122 + (x xor 120)*123 + (x xor 121)*124 + (x xor 122)*125 + 