# floor(log2(x)) of an f32 x proved positive and normal by its exponent
# field, (asuint(x) >> 23) - 127 (#165): converted to an integer the floor
# and the log2 go (10 -> 3 under gt1030; int(log2(z)) of z >= 1 too,
# 7 -> 3), left a float it is the field's conversion (7 -> 6).  The field
# is the exact floor; a GPU's log2 is within 3 ulp, so the call may give
# one more just below a power of two (correctly rounded log2f does at 7404
# of the 2^31 positive normal floats): not with `exact`, and not for an x
# with no bound.
simplify nofile nofunctions under gt1030
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
layout(std430, binding = 1) buffer F { float f[]; } o;
layout(std430, binding = 2) buffer I { int i[]; } q;
void main() {
    uint i = gl_GlobalInvocationID.x;
    float x = float(b.d[i] & 4095u) + 1.0, z = float(b.d[i + 64u] & 255u) + 2.0;
    float w = float(b.d[i + 128u] & 1023u) * 0.25 + 0.125;
    float y = uintBitsToFloat(b.d[i + 192u]);
    q.i[i] = int(floor(log2(x)));
    q.i[i + 64u] = int(log2(z));
    o.f[i] = floor(log2(w));
    o.f[i + 64u] = floor(log2(y));
}
```
simplify nofile nofunctions exact under gt1030
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
layout(std430, binding = 1) buffer F { float f[]; } o;
layout(std430, binding = 2) buffer I { int i[]; } q;
void main() {
    uint i = gl_GlobalInvocationID.x;
    float x = float(b.d[i] & 4095u) + 1.0, z = float(b.d[i + 64u] & 255u) + 2.0;
    float w = float(b.d[i + 128u] & 1023u) * 0.25 + 0.125;
    float y = uintBitsToFloat(b.d[i + 192u]);
    q.i[i] = int(floor(log2(x)));
    q.i[i + 64u] = int(log2(z));
    o.f[i] = floor(log2(w));
    o.f[i + 64u] = floor(log2(y));
}
```
