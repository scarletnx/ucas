# A block goes to the statement just before it: that line and the
# indented lines it continues.  The lines above run as they are, before
# it: a definition is defined, a show prints, and a range of theirs is no
# assumption of the request.
f(x: u32) = x + 1
show f(2)
g(i: i32 in -8..7) = i * 3
show g(-8)
simplify nofile
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() { uint i = gl_GlobalInvocationID.x; b.d[i] = (b.d[i] * 4u) & 0xffu; }
```
# an indented line continues the request, and its range is the request's
show f(3)
simplify nofile,
    x in [1, 2]
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() { uint i = gl_GlobalInvocationID.x; b.d[i] = (b.d[i] * 4u) & 0xffu; }
```
# the statement before the block asks for no simplify: every line runs,
# and the block is not used
simplify x + x
h(y: u32) = y * 2
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() { uint i = gl_GlobalInvocationID.x; b.d[i] = (b.d[i] * 4u) & 0xffu; }
```
