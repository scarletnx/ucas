> abexact Z -> Z -> Z/4 by [[4]], [[1]]
Z -> Z -> Z/4: exact at Z
  preimages of the generators of ker g: [[1]]
  check: g f = 0, and f(preimages) = the generators of ker g modulo relations
> abexact Z -> Z -> Z/4 by [[2]], [[1]]
Z -> Z -> Z/4: not exact at Z
  why: the composite is not zero (im f is not inside ker g)
> abexact Z/2 -> Z/4 -> Z/2 by [[2]], [[1]]
Z/2 -> Z/4 -> Z/2: exact at Z/4
  preimages of the generators of ker g: [[1]]
  check: g f = 0, and f(preimages) = the generators of ker g modulo relations
