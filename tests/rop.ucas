# Graphics fixed function as compute (src/rop.c): the update a scatter
# applies to a cell, F(s, d), against the catalogue of fixed-function
# states.  Every state is compared with F on F's domain; each is a
# proposal with its pipeline, priced by a class no built-in model lists
# (nothing is measured yet).

# a histogram of bytes: additive blending on a float target is exact
# while the counts stay below 2^24, and then the order does not matter
acc(s: u32 in 0..255, d: u32 in 0..1000000) = d + s
rop acc
# the same sum without a bound: the blend equation is the same, f32 is
# not exact, and integer targets do not blend
big(s: u32, d: u32) = d + s
rop big
# a weighted sum: the weight is a second output (dual-source blending),
# or a pipeline constant when it is uniform
wsum(s: u32 in 0..255, w: u32 in 0..16, d: u32 in 0..100000) = d + s*w
rop wsum
wk(s: u32 in 0..255, k: u32 in 0..16 uniform, d: u32 in 0..100000) = d + s*k
rop wk

# bitsets: logic ops on an unsigned integer target, any order
bits(s: u32, d: u32) = d | s
rop bits
tog(s: u16, d: u16) = d xor s
rop tog
clr(s: u8, d: u8) = d & ~s
rop clr
# a logic op whose result depends on the order: still that state, for
# a sequential loop, not for atomics
ord(s: u32, d: u32) = s & ~d
rop ord

# counters in the stencil buffer: wrapping, saturating, under a write
# mask, the reference value
cnt(d: u8) = d + 1
rop cnt
sat(d: u8) = d == 255 ? 255 : d + 1
rop sat
low(d: u8) = (d & 0xf0) | ((d + 1) & 0x0f)
rop low
ref(k: u8 uniform, d: u8) = k
rop ref
inv(d: u8) = ~d
rop inv

# bytes on a normalized target: the clamp to [0, 1] is a saturating
# add; min and max
sadd(s: u8, d: u8) = u8(min(u32(d) + u32(s), 255))
rop sadd
lo(s: u8, d: u8) = min(s, d)
rop lo

# floats: one add (exact if the blender rounds to nearest), min, and
# equations that are several operations (equal as real functions)
fa(s: f32, d: f32) = d + s
rop fa
fm(s: f32, d: f32) = min(d, s)
rop fm
kb(s: f32, k: f32 uniform, d: f32) = d + s*k
rop kb
lerp(s: f32, t: f32, d: f32) = s*t + d*(1.0 - t)
rop lerp
# screen and exclusion are blend equations with ONE_MINUS factors, and
# advanced blend operations too; a difference is only the latter, and
# needs colours in [0, 1]
scr(s: f32 in 0..1, d: f32 in 0..1) = s + d - s*d
rop scr
exc(s: f32 in 0..1, d: f32 in 0..1) = s + d - 2.0*s*d
rop exc
dif(s: f32 in 0..1, d: f32 in 0..1) = abs(d - s)
rop dif
difx(s: f32, d: f32) = abs(d - s)
rop difx

# nothing in the catalogue: a multiply of the cell by 3 is no factor
nope(s: u32, d: u32) = d * 3 + s
rop nope

# with a model that prices the states: cheaper than the atomic or not
model fixed : gt1030 { rop_blend: 2, rop_logic: 60 }
rop acc model fixed
rop bits under fixed
use fixed
rop cnt
# a float add is priced against the float atomic, an update that is no
# atomic against a compare-and-swap loop
rop fa
rop kb
use gt1030

# English, and what rop refuses
the blend state for acc
the logic op for a | b with u32 a and b
show me the fixed-function forms of cnt on fixed
rop sat model nomodel
bad(s: u32, d: f32) = d + 1.0
rop bad
two(a: u32 uniform, b: u32 uniform, d: u32) = d + a + b
rop two
sg(s: i32, d: i32) = d + s
rop sg

# the depth test: a min or a max whose high bits are the key and whose
# low bits, the payload, ride in a colour target (an argmin).  The key
# goes in as the float whose bits are key + 2^23, which D32_SFLOAT keeps
# and compares exactly below 0x3F000000; the fewest low bits are left
# out of the key for it to fit.  On a tie the test keeps one by the
# order the fragments come in, so the payloads must come in increasing
# order (the contribution's index in the draw).
am(s: u64, d: u64) = min(d, s)
rop am
# a 32-bit key and a 32-bit payload, when the range keeps the key below
# 0x3F000000; max is GREATER_OR_EQUAL (reversed-Z, an argmax)
pk(s: u64 in 0..4539628424389459967, d: u64 in 0..4539628424389459967) = min(s, d)
rop pk
far(s: u32, d: u32) = max(s, d)
rop far
# values that fit the depth whole: the test alone, ties are equal values
near(s: u32 in 0..1000000, d: u32 in 0..1000000) = min(d, s)
rop near
# priced against the 64-bit atomic it replaces
model depthy : gt1030 { rop_depth: 4 }
rop am model depthy
# u64 cells: a logic op on two 32-bit channels
bits64(s: u64, d: u64) = d | s
rop bits64

# a count over a whole draw: a precise occlusion query, every fragment
# or those where s is not 0 (cnt above has it too); one cell for the
# draw, priced against an atomic add of the 0 or 1
hits(s: u32, d: u32) = d + (s != 0 ? 1 : 0)
rop hits
h64(s: u64, d: u64) = d + (s != 0 ? 1 : 0)
rop h64
model qm : gt1030 { rop_query: 3 }
rop hits model qm

# a predicate of the pixel over a grid: a conjunction of half-planes is
# what the rasteriser's edge functions test, a convex polygon drawn over
# the grid (its vertices on the 1/16 sub-pixel grid every device has,
# its edges through no pixel centre)
tri(x: i32 in 0..255, y: i32 in 0..255) = x + 2*y >= 40 && 3*x - y < 400 && y <= 200 - x
rop tri
half(x: i32 in 0..63, y: i32 in 0..63) = x > y
rop half
# not half-planes, too steep for the 1/16 grid, wrapping in u32, empty
disc(x: i32 in 0..63, y: i32 in 0..63) = x*x + y*y < 900
rop disc
steep(x: i32 in 0..255, y: i32 in 0..255) = 97*x - 31*y >= 5
rop steep
uw(x: u32 in 0..255, y: u32 in 0..255) = 3*x - y < 400
rop uw
none(x: i32 in 0..15, y: i32 in 0..15) = x > 20
rop none
model rz : gt1030 { rop_raster: 1 }
rop tri model rz

# 4 or 8 values of one type, none the cell, are a pixel's samples: the
# depth and stencil resolve modes pick one (SAMPLE_ZERO, MIN, MAX); the
# mean of a colour resolve is the implementation's arithmetic
dmin(a: f32 in 0..1, b: f32 in 0..1, c: f32 in 0..1, e: f32 in 0..1) = min(min(a, b), min(c, e))
rop dmin
smax(a: u8, b: u8, c: u8, e: u8) = max(a, max(b, max(c, e)))
rop smax
z8(a: u32 in 0..1000, b: u32 in 0..1000, c: u32 in 0..1000, e: u32 in 0..1000, g: u32 in 0..1000, h: u32 in 0..1000, i: u32 in 0..1000, j: u32 in 0..1000) = a
rop z8
big4(a: u32, b: u32, c: u32, e: u32) = min(min(a, b), min(c, e))
rop big4
mean(a: f32, b: f32, c: f32, e: f32) = (a + b + c + e) / 4.0
rop mean

# every cell set to one constant: the transfer engine's fill or clear,
# no shader (a literal update is read in the cell's type); priced
# against a store
z(d: u32) = 7
rop z
zb(d: u8) = 255
rop zb
zf(d: f32) = 0.5
rop zf
z64(d: u64) = 4294967297
rop z64
model fl : gt1030 { rop_fill: 0.25 }
rop z model fl

# signed data blends on a float target as unsigned data does; values
# below 2^11 fit R16_SFLOAT, half the bytes; integer min and max on a
# float target; a logic op on a SINT target
sgb(s: i32 in -100..100, d: i32 in -1000000..1000000) = d + s
rop sgb
small(s: u32 in 0..15, d: u32 in 0..2000) = d + s
rop small
sm(s: i32 in -1000..1000, d: i32 in -1000..1000) = min(d, s)
rop sm
ix(s: i16, d: i16) = d xor s
rop ix
