# A shader with an #extension line.  The module then carries an
# OpSourceExtension next to OpSource, and its name is not the source text:
# the function level used to be handed the name, and crashed on it.
simplify nofile
```glsl
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer B { uint v[]; } b;
uint lowhalf(uint x) { return uint(uint16_t(x)) / 2u; }
void main() { b.v[gl_GlobalInvocationID.x] = lowhalf(b.v[gl_GlobalInvocationID.x] & 0xffffu); }
```
