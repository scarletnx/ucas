  /* ring: a linear congruence, 3x + 5 = 2 (mod 7) <=> x = 6 (mod 7) */
  int cong(uint16_t x) { return (3 * x + 5) % 7 == 2; }
  
  /* ring: x * 7 == 21 (mod 2^32) <=> x == 21 * 7^-1 = 3 */
  int inv_eq(uint32_t x) { return x * 7u == 21u; }
  
  /* ring: two congruences joined by the CRT */
  int crt2(uint32_t x) { return x % 3 == 1 && x % 5 == 2; }
  
  /* dio: x*x = 3 (mod 4) has no solution */
  #if defined(__POPCNT__) || defined(__LZCNT__) || defined(__BMI__)
  #include <immintrin.h>
  #endif
  static inline uint64_t cf_ctz64(uint64_t x)
  {
  #if defined(__BMI__)
  	return (uint64_t)_tzcnt_u64(x);
  #elif defined(__GNUC__)
  	return x ? (uint64_t)__builtin_ctzll(x) : 64u;
  #else
  	uint64_t n = 0;
  	if (!x) return 64;
  	while (!(x & 1)) { x >>= 1; n++; }
  	return n;
  #endif
  }
  static inline uint64_t cf_powu64(uint64_t b, uint64_t e)
  {
  	uint64_t r = 1;
  	while (e) {
  		if (e & 1)
  			r *= b;
  		b *= b;
  		e >>= 1;
  	}
  	return r;
  }
