  /* loops into integrals: a left Riemann sum of x^2 on [0, 1] */
  double riemann(int n)
  {
  	double h = 1.0 / n, s = 0;
  	for (int i = 0; i < n; i++) {
  		double x = i * h;
  		s += x * x * h;
  	}
  	return s;
  }
  
