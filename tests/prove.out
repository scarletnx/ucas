axioms used:
  int_discrete   [integer arithmetic] forall n:int: n <= 0 or 1 <= n
  le_antisym     [integer arithmetic] forall a:int: 0 <= a and 0 <= -a -> a = 0
  mul_nonneg     [integer arithmetic] forall a b:int: 0 <= a and 0 <= b -> 0 <= a*b
  int_domain     [integer arithmetic] forall a b:int: a*b = 0 -> a = 0 or b = 0
  pow_succ       [integer arithmetic] forall a m:int: 0 <= m -> a^(m+1) = a^m*a
  subgroup_def   [definition] forall S:set: subgroup(S) <-> (0 in S and (forall x y:el: x in S and y in S -> x + y in S) and (forall x:el: x in S -> -x in S))
  ssum_def       [definition] forall A B:set, x:el: x in ssum(A,B) <-> (exists a b:el: a in A and b in B and x = a + b)
  summand_def    [definition] forall S T:set: summand(S,T) <-> (exists M:set: subgroup(S) and subgroup(T) and subgroup(M) and (forall x:el: x in S -> x in T) and (forall x:el: x in M -> x in T) and (forall x:el: x in T -> exists s m:el: s in S and m in M and x = s + m) and (forall s m:el: s in S and m in M and s + m = 0 -> s = 0))
  zsummand_def   [definition] forall a:el, S:set: zsummand(a,S) <-> (exists M:set: a in S and subgroup(S) and subgroup(M) and (forall x:el: x in M -> x in S) and (forall x:el: x in S -> exists n:int, m:el: m in M and x = n*a + m) and (forall n:int, m:el: m in M and n*a + m = 0 -> n = 0))
  excouple_def   [definition] forall c:cpl: excouple(c) <-> (subgroup(D(c)) and subgroup(E(c)) and (forall x:el: x in D(c) -> i(c,x) in D(c)) and (forall x:el: x in D(c) -> j(c,x) in E(c)) and (forall e:el: e in E(c) -> k(c,e) in D(c)) and (forall x:el: x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)) and (forall x:el: x in D(c) -> j(c,i(c,x)) = 0) and (forall e:el: e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)) and (forall x:el: x in D(c) -> k(c,j(c,x)) = 0) and (forall x:el: x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)) and (forall e:el: e in E(c) -> i(c,k(c,e)) = 0))
  ipow_zero      [definition] forall c:cpl, x:el: ipow(c,0,x) = x
  ipow_succ      [definition] forall c:cpl, m:int, x:el: 0 <= m -> ipow(c,m+1,x) = i(c,ipow(c,m,x))
  ipow_neg       [definition] forall c:cpl, m:int, x:el: m < 0 -> ipow(c,m,x) = 0
  D1_def         [definition] forall c:cpl, x:el: Dr(c,1,x) <-> x in D(c)
  Z1_def         [definition] forall c:cpl, e:el: Zr(c,1,e) <-> e in E(c)
  B1_def         [definition] forall c:cpl, e:el: Br(c,1,e) <-> e = 0
  J1_def         [definition] forall c:cpl, x e:el: Jr(c,1,x,e) <-> (x in D(c) and e = j(c,x))
  Dsucc_def      [definition] forall c:cpl, r:int, y:el: 1 <= r -> (Dr(c,r+1,y) <-> (exists x:el: Dr(c,r,x) and y = i(c,x)))
  Zsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Zr(c,r+1,e) <-> (Zr(c,r,e) and exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f)))
  Bsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Br(c,r+1,e) <-> (exists e0 f:el: Zr(c,r,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f)))
  Jsucc_def      [definition] forall c:cpl, r:int, y e:el: 1 <= r -> (Jr(c,r+1,y,e) <-> (exists x f:el: Dr(c,r,x) and y = i(c,x) and Jr(c,r,x,f) and Br(c,r+1,e - f)))
  dzero_def      [definition] forall c:cpl, r:int, e:el: dzero(c,r,e) <-> (exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f))
  dimg_def       [definition] forall c:cpl, r m:int, e:el: dimg(c,r,m,e) <-> (exists e0 f:el: Zr(c,r,e0) and Edeg(c,m,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f))
  prime_def      [definition] forall p:int: prime(p) <-> (2 <= p and (forall d q:int: 1 <= d and p = d*q -> d = 1 or d = p))
  bock_couple    [definition] forall C:cx, p:int: fintype(C) and prime(p) -> excouple(bock(C,p))
  bock_D         [definition] forall C:cx, p:int, x:el: x in D(bock(C,p)) <-> x in Htot(C)
  bock_i         [definition] forall C:cx, p:int, x:el: i(bock(C,p),x) = p*x
  H_summand      [definition] forall C:cx, n:int: summand(H(C,n), Htot(C))
