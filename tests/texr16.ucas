# A filtered read's texture in 16 bits (src/texalu.c, table_info): the
# format is the cheapest the model lists among those that hold the table
# (bytes, 16-bit units, half floats, f32); levels and an f16 rounding only
# approximate it and are dropped when the bound is over the budget
model texel : gt1030 { tex_nearest: 6.875, subtexel: 8, tex_within: 2 }
model t16 : texel { tex_sample_16: 8, tex_sample_f16: 9 }
# entries an f16 holds: R16_SFLOAT at 9 against R32_SFLOAT at 54.75
H = [0.5, 1.25, 3.0, 7.5, 2.0, 0.125, 6.0, 1.0]
f1(i: u8 in 0..6, t: f32 in 0.0..1.0) = (1 - t) * H[i] + t * H[i + 1]
texalu f1 tol 0.05 under texel
texalu f1 tol 0.05 under t16
# whole numbers past 255 (rows of 3) as 16-bit units: an integer sum of
# four stays exact
U = [0, 3001, 40000, 65535, 12345, 777]
f2(i: u8 in 0..1) = U[i] + U[i + 1] + U[i + 3] + U[i + 4]
texalu f2 under texel
texalu f2 under t16
# 300 evenly spaced levels (steps of 0.001), more than bytes hold
V = [0.5, 0.501, 0.517, 0.799, 0.6]
f3(i: u8 in 0..3, t: f32 in 0.0..1.0) = (1 - t) * V[i] + t * V[i + 1]
texalu f3 tol 0.01 under t16
# entries no 16-bit form holds: rounded to f16 where the tolerance
# allows, f32 (dearer here) where it does not
R = [0.1, 0.7123, 0.33, 0.9, 0.05]
f4(i: i32 in 0..3) = 0.5 * R[i] + 0.5 * R[i + 1]
texalu f4 tol 0.01 under t16
texalu f4 tol 1e-6 under t16
# a nearest read of a float table an f16 holds takes half the bytes
f5(i: u32 in 0..1000) = [0.5, 1.25, 3.0, 7.5, 2.0, 0.125, 6.0][i % 7]
texalu f5 under texel
