# gl_FragCoord is the window position, the depth and 1/w, each affine
# across a primitive in window coordinates: what is affine in it, with
# the draw's values as coefficients, is a noperspective varying (once a
# vertex); a vignette's offset from the centre is, its squared length is
# not
simplify advice nofile
```glsl
#version 450
layout(location = 0) out vec4 col;
layout(push_constant) uniform PC { vec2 invres; vec2 centre; float k; } pc;
void main() {
    vec2 uv = gl_FragCoord.xy * pc.invres;
    vec2 d = uv - pc.centre;
    float v = 1.0 - dot(d, d) * pc.k;
    col = vec4(v, v, v, 1.0);
}
```
# a projective term: its numerator and its denominator are each affine
# (two noperspective varyings), the division stays per pixel; mixed with
# a perspective-correct varying, or scaled by a flat value, it is per run
simplify advice nofile
```glsl
#version 450
layout(location = 0) in vec2 tc;
layout(location = 1) flat in float fl;
layout(location = 0) out vec4 col;
layout(push_constant) uniform PC { vec4 pl; } pc;
void main() {
    float num = gl_FragCoord.x * pc.pl.x + pc.pl.y;
    float den = gl_FragCoord.y * pc.pl.z + pc.pl.w;
    float q = num / den;
    float m = gl_FragCoord.x + tc.x;
    float f = gl_FragCoord.y * fl;
    col = vec4(q, m, f, 1.0);
}
```
# a fragment shader's discard on the sign of a value affine in the
# (perspective-correct) varyings against one of the draw is what a clip
# distance does: the clipper removes the part, no fragment runs there
simplify advice nofile
```glsl
#version 450
layout(location = 0) in vec3 wpos;
layout(location = 0) out vec4 col;
layout(push_constant) uniform PC { vec4 plane; } pc;
void main() {
    if (dot(wpos, pc.plane.xyz) + pc.plane.w < 0.0) discard;
    col = vec4(wpos, 1.0);
}
```
# not with a noperspective varying (a clip distance interpolates in clip
# space), nor in a shader that writes memory others see before it
# discards (a clipped fragment never runs)
simplify advice nofile
```glsl
#version 450
layout(location = 0) noperspective in float np;
layout(location = 0) out vec4 col;
void main() {
    if (np > 0.5) discard;
    col = vec4(np);
}
```
simplify advice nofile
```glsl
#version 450
layout(location = 0) in float h;
layout(location = 0) out vec4 col;
layout(std430, binding = 0) buffer B { uint seen; } bb;
void main() {
    atomicAdd(bb.seen, 1u);
    if (h < 0.25) discard;
    col = vec4(h);
}
```
# what the inputs are is recognised and reported, never proposed: flat
# inputs, per-vertex inputs and the barycentrics, and a sum over the
# three vertices of a per-vertex value times its vertex's barycentric,
# which is the interpolation a smooth varying is
simplify advice nofile
```glsl
#version 450
#extension GL_EXT_fragment_shader_barycentric : require
layout(location = 0) pervertexEXT in vec4 vc[];
layout(location = 3) flat in uint mat;
layout(location = 0) out vec4 col;
void main() {
    vec4 c = vc[0] * gl_BaryCoordEXT.x + vc[1] * gl_BaryCoordEXT.y + vc[2] * gl_BaryCoordEXT.z;
    col = c * float(mat);
}
```
# each vertex's term reads another component: no one value is
# interpolated, so none is named; the same component of each is
simplify nofile
```glsl
#version 450
#extension GL_EXT_fragment_shader_barycentric : require
layout(location = 0) pervertexEXT in vec3 v[];
layout(location = 0) out vec4 col;
void main() {
    float a = v[0].x * gl_BaryCoordEXT.x + v[1].y * gl_BaryCoordEXT.y + v[2].z * gl_BaryCoordEXT.z;
    float b = v[0].y * gl_BaryCoordEXT.x + v[1].y * gl_BaryCoordEXT.y + v[2].y * gl_BaryCoordEXT.z;
    col = vec4(a, b, 0.0, 1.0);
}
```
# the noperspective barycentrics, and a sum over two vertices only, which
# is not an interpolation
simplify nofile
```glsl
#version 450
#extension GL_EXT_fragment_shader_barycentric : require
layout(location = 0) pervertexEXT in float w[];
layout(location = 0) out vec4 col;
void main() {
    float a = w[0] * gl_BaryCoordNoPerspEXT.x + w[1] * gl_BaryCoordNoPerspEXT.y + w[2] * gl_BaryCoordNoPerspEXT.z;
    float b = w[0] * gl_BaryCoordNoPerspEXT.x + w[1] * gl_BaryCoordNoPerspEXT.y;
    col = vec4(a, b, 0.0, 1.0);
}
```
