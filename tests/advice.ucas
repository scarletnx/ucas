# nothing of a lower frequency
simplify advice nofile
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { float o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    o[i] = o[i] * 2.0 + 1.0;
}
