    t4 = fma(a, b, t3)                       !
    t5 = t2 + c                              !
    t6 = t2 - t5                             !
    t7 = t1 - t5                             !
    t8 = c + t6                              !
    t9 = t7 - t8                             !
    t10 = t4 + t9
    t11 = t2 + t10                           !
    result: t11
