# The function level reads a switch as a chain of ifs on its selector when
# no case falls into the next (a case's break goes, labels that share a
# body share an if, default is the last else), and knows bitfieldExtract's
# values: Byte's clamp never bites, from every case of Lane; Fall, whose
# first case falls into the second, is not read, and its min stays
simplify functions nofile budget 30
```comp
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };
uint Byte(int v) {
    return uint(clamp(v, 0, 255));
}
uint Lane(uint mode, uint q) {
    const int lo = int(bitfieldExtract(q, 0, 8)), hi = int(bitfieldExtract(q, 8, 7));
    switch (mode) {
    case 0u:
        return Byte(lo);
    case 1u:
    case 2u: {
        const int s = lo + hi;
        return Byte(s >> 1);
    }
    default:
        break;
    }
    return Byte(hi);
}
uint Fall(uint mode, uint q) {
    uint r = 0u;
    switch (mode) {
    case 0u:
        r = q & 3u;
    case 1u:
        r += 1u;
        break;
    default:
        r = 9u;
    }
    return min(r, 9u);
}
void main() {
    uint i = gl_GlobalInvocationID.x, q = src[i];
    dst[i] = Lane(q >> 30u, q) + Fall(q >> 30u, q);
}
```
