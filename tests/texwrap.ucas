# A linear filter that wraps (src/texalu.c, the weighted sums): a mix of
# T[i % n] and T[(i + 1) % n] is one read with REPEAT, of the mirrored
# indices one with MIRRORED_REPEAT, in normalised coordinates
model texel : gt1030 { tex_nearest: 6.875, subtexel: 8, tex_within: 2 }
model wr : texel { tex_sample_f32: 9 }
# the operations: u is normalised, the unit reads u n
show tex_repeat8([0.0, 1.0, 4.0, 9.0], 1.0)
show tex_repeat8([0.0, 1.0, 4.0, 9.0], 0.0)
show tex_mirror8([0.0, 1.0, 4.0, 9.0], 0.0)
show tex_mirror8([0.0, 1.0, 4.0, 9.0], 1.0)
# a periodic table, 8 entries (a power of two: the normalised coordinate
# is exact) and 7 (it is not)
G = [0.1, 0.5, 0.25, 0.75, 1, 0, 0.5, 0.5]
w1(i: u16 in 0..1000, t: f32 in 0..1) = (1 - t)*G[i % 8] + t*G[(i + 1) % 8]
texalu w1 tol 0.01 under wr
G7 = [0.1, 0.5, 0.25, 0.75, 1, 0, 0.5]
w2(i: u16 in 0..1000) = 0.5*G7[i % 7] + 0.5*G7[(i + 1) % 7]
texalu w2 tol 1e-4 under wr
texalu w2 tol 1e-3 under wr
# mirrored
w3(i: u16 in 0..1000, t: f32 in 0..1) = (1 - t)*G7[min(i % 14, 13 - i % 14)] + t*G7[min((i + 1) % 14, 13 - (i + 1) % 14)]
texalu w3 tol 0.01 under wr
# without the wrap the pair can leave the table
w4(i: u16 in 0..1000, t: f32 in 0..1) = (1 - t)*G[i % 8] + t*G[i % 8 + 1]
texalu w4 tol 0.01 under wr
# REPEAT makes the last entry and the first neighbours: their step (6)
# is the largest a weight's move can meet, not the largest inside (4)
G6 = [3.0, 2.5, 2.0, 1.5, 1.0, -3.0]
w5(i: u8 in 0..5, t: f32 in 0..1) = (1 - t)*G6[i % 6] + t*G6[(i + 1) % 6]
texalu w5 tol 0.1 under wr
# every axis wrapped, in 2-D and 3-D (tex_birepeat, tex_bimirror,
# tex_trirepeat, tex_trimirror): at (0, 0) a REPEAT read takes the four
# corners of the table, a MIRRORED_REPEAT one texel (0, 0) four times
show tex_birepeat8([0, 1, 2, 3, 4, 5], 3, 0.0, 0.0)
show tex_bimirror8([0, 1, 2, 3, 4, 5], 3, 0.0, 0.0)
show tex_birepeat8([0, 1, 2, 3, 4, 5], 3, 0.5/3, 0.25)
show tex_trirepeat8([0, 1, 2, 3, 4, 5, 6, 7], 2, 2, 0.0, 0.0, 0.0)
show tex_trimirror8([0, 1, 2, 3, 4, 5, 6, 7], 2, 2, 0.0, 0.0, 0.0)
# a blend of a 4 x 3 table wrapped along both axes, an index (y mod 3) 4
# + x mod 4 for each texel: one read with REPEAT on u and v
G12 = [0.1, 0.5, 0.25, 0.75, 1, 0, 0.5, 0.5, 0.125, 0.875, 0.375, 0.625]
r1(x: u16 in 0..1000, y: u16 in 0..1000, s: f32 in 0..1, t: f32 in 0..1) = (1-s)*(1-t)*G12[(y % 3)*4 + x % 4] + s*(1-t)*G12[(y % 3)*4 + (x + 1) % 4] + (1-s)*t*G12[((y + 1) % 3)*4 + x % 4] + s*t*G12[((y + 1) % 3)*4 + (x + 1) % 4]
texalu r1 tol 0.02 under wr
# sums of bytes, exact: 2 x 2 wrapped by REPEAT and by MIRRORED_REPEAT,
# and 2 x 2 x 2 of a 4 x 3 x 2 table wrapped by REPEAT
model wb : texel { tex_3d: 2 }
B12 = [121, 66, 189, 242, 33, 6, 240, 132, 119, 98, 240, 243]
r2(x: u16 in 0..1000, y: u16 in 0..1000) = B12[(y % 3)*4 + x % 4] + B12[(y % 3)*4 + (x + 1) % 4] + B12[((y + 1) % 3)*4 + x % 4] + B12[((y + 1) % 3)*4 + (x + 1) % 4]
texalu r2 under wb
r3(x: u16 in 0..1000, y: u16 in 0..1000) = B12[min(y % 6, 5 - y % 6)*4 + min(x % 8, 7 - x % 8)] + B12[min(y % 6, 5 - y % 6)*4 + min((x + 1) % 8, 7 - (x + 1) % 8)] + B12[min((y + 1) % 6, 5 - (y + 1) % 6)*4 + min(x % 8, 7 - x % 8)] + B12[min((y + 1) % 6, 5 - (y + 1) % 6)*4 + min((x + 1) % 8, 7 - (x + 1) % 8)]
texalu r3 under wb
B24 = [121, 66, 189, 242, 33, 6, 240, 132, 119, 98, 240, 243, 203, 77, 118, 77, 199, 7, 32, 81, 21, 154, 15, 137]
r4(x: u8 in 0..200, y: u8 in 0..200, z: u8 in 0..200) = B24[(z % 2)*12 + (y % 3)*4 + x % 4] + B24[(z % 2)*12 + (y % 3)*4 + (x + 1) % 4] + B24[(z % 2)*12 + ((y + 1) % 3)*4 + x % 4] + B24[(z % 2)*12 + ((y + 1) % 3)*4 + (x + 1) % 4] + B24[((z + 1) % 2)*12 + (y % 3)*4 + x % 4] + B24[((z + 1) % 2)*12 + (y % 3)*4 + (x + 1) % 4] + B24[((z + 1) % 2)*12 + ((y + 1) % 3)*4 + x % 4] + B24[((z + 1) % 2)*12 + ((y + 1) % 3)*4 + (x + 1) % 4]
texalu r4 under wb
# controls: a table wrapped along x only (one address mode for every axis)
r5(x: u16 in 0..1000, y: u16 in 0..1) = B12[y*4 + x % 4] + B12[y*4 + (x + 1) % 4] + B12[(y + 1)*4 + x % 4] + B12[(y + 1)*4 + (x + 1) % 4]
texalu r5 under wb
