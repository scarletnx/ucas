  fuse shfl_xor(v: any, lane: lane, k: const) = sg_shuffle(v, lane xor k) : sg_shuffle
  fuse shfl_rot(v: any, lane: lane, d: const, w: const) = sg_shuffle(v, (lane + d) % w) : sg_shuffle
  fuse ballot_bit(a: int) = sg_ballot(a & 1 != 0) : 2.625
  fuse lop3 = lut 3 : logic
  fuse imad(a: int, b: int, c: int) = a*b + c : imul
  fuse shl_add(a: int, k: const, b: int) = (a << k) + b : shift
  fuse shr_add(a: int, k: const, b: int) = (a >> k) + b : shift
  fuse ffma(a: float, b: float, c: float) = a*b + c : fmul contract
  fuse ffms(a: float, b: float, c: float) = a*b - c : fmul contract
  fuse ffmr(a: float, b: float, c: float) = c - a*b : fmul contract
  fuse fneg(a: float) = -a : 0 in fadd fmul
  fuse fabs(a: float) = abs(a) : 0 in fadd fmul
  folds f32 -> f16 -> f32
