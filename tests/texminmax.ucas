# A min or max of neighbouring table entries as one read with a MIN or
# MAX reduction sampler (src/texalu.c, seed_minmax): read at the centre
# of the footprint, every weight is non-zero on any sub-texel grid
model texel : gt1030 { tex_nearest: 6.875, subtexel: 8, tex_within: 2 }
model mm : texel { tex_minmax: 8 }
# the operations: the texels whose weight is not 0
show tex_min8([4.0, 1.0, 9.0], 1.0)
show tex_max8([4.0, 1.0, 9.0], 1.0)
show tex_max8([4.0, 1.0, 9.0], 1.5)
show tex_bimax8([1.0, 5.0, 2.0, 7.0, 3.0, 8.0], 3, 2.0, 1.0)
show tex_bimin8([1.0, 5.0, 2.0, 7.0, 3.0, 8.0], 3, 1.25, 1.0)
# two along a row, of floats an f16 holds and of floats it does not
H = [0.5, 1.25, 3.0, 7.5, 2.0, 0.125, 6.0, 1.0]
m1(i: u8 in 0..6) = min(H[i], H[i + 1])
texalu m1 under mm
F = [f32(0.1), f32(0.7), f32(0.33), f32(0.9), f32(0.05)]
m2(i: u8 in 1..3) = max(F[i + 1], F[i])
texalu m2 under mm
# a 2 x 2 block of a table read as rows of 4, nested
P = [3.0, 1.0, 4.0, 1.0, 5.0, 9.0, 2.0, 6.0, 5.0, 3.0, 5.0, 8.0]
m3(x: u8 in 0..2, y: u8 in 0..1) = max(max(P[y*4 + x], P[y*4 + x + 1]), max(P[y*4 + x + 4], P[y*4 + x + 5]))
texalu m3 under mm
# whole numbers 0..255 as normalised bytes, scaled back
B = [10, 200, 30, 40, 250, 6]
m4(i: u8 in 0..4) = min(B[i], B[i + 1])
texalu m4 under mm
# entries that are not neighbours, a pair that can leave the table, and a
# model with no price for the read
m5(i: u8 in 0..5) = min(H[i], H[i + 2])
texalu m5 under mm
m6(i: u8 in 0..7) = min(H[i], H[i + 1])
texalu m6 under mm
texalu m1 under texel
# a 3-D texture's footprint, 2 x 2 x 2 (tex_trimin, tex_trimax): the
# eight texels around (0.5, 0.5, 0.5), the two of a fraction 1/2 along z
# only, a texel's centre alone, and a width that is no size
show tex_trimin8([0, 1, 2, 3, 4, 5, 6, 7], 2, 2, 0.5, 0.5, 0.5)
show tex_trimax8([0, 1, 2, 3, 4, 5, 6, 7], 2, 2, 0.5, 0.5, 0.5)
show tex_trimax8([0, 1, 2, 3, 4, 5, 6, 7], 2, 2, 0.25, 0.25, 0.5)
show tex_trimax8([0, 1, 2, 3, 4, 5, 6, 7], 2, 2, 0.25, 0.25, 0.25)
show tex_trimin8([0, 1, 2, 3, 4, 5, 6, 7], 0, 2, 0.25, 0.25, 0.25)
# a 2 x 2 x 2 block of a 3 x 4 x 3 table, nested in any order: one read
# at the block's centre, its coordinates normalised; with no tex_3d in the
# model, the pairs along a row
model mm3 : mm { tex_3d: 2 }
Q = [3.0, 1.0, 4.0, 1.0, 5.0, 9.0, 2.0, 6.0, 5.0, 3.0, 5.0, 8.0, 9.0, 7.0, 9.0, 3.0, 2.0, 3.0, 8.0, 4.0, 6.0, 2.0, 6.0, 4.0, 3.0, 3.0, 8.0, 3.0, 2.0, 7.0, 9.0, 5.0, 0.0, 2.0, 8.0, 8.0]
m7(x: u8 in 0..1, y: u8 in 0..2, z: u8 in 0..1) = max(max(max(Q[z*12 + y*3 + x + 16], Q[z*12 + y*3 + x]), max(Q[z*12 + y*3 + x + 3], Q[z*12 + y*3 + x + 13])), max(max(Q[z*12 + y*3 + x + 12], Q[z*12 + y*3 + x + 1]), max(Q[z*12 + y*3 + x + 15], Q[z*12 + y*3 + x + 4])))
texalu m7 under mm3
texalu m7 under mm
# bytes as normalised units, a 4 x 4 x 4 table: every size a power of two,
# so the coordinates are exact
C = [121, 66, 189, 242, 33, 6, 240, 132, 119, 98, 240, 243, 203, 77, 118, 77, 199, 7, 32, 81, 21, 154, 15, 137, 242, 198, 218, 202, 227, 68, 187, 49, 18, 69, 253, 111, 132, 223, 154, 215, 197, 179, 208, 118, 172, 14, 143, 83, 167, 53, 108, 136, 145, 63, 32, 246, 247, 45, 176, 34, 210, 77, 10, 150]
m8(x: u8 in 0..2, y: u8 in 0..2, z: u8 in 0..2) = min(min(min(C[z*16 + y*4 + x], C[z*16 + y*4 + x + 1]), min(C[z*16 + y*4 + x + 4], C[z*16 + y*4 + x + 5])), min(min(C[z*16 + y*4 + x + 16], C[z*16 + y*4 + x + 17]), min(C[z*16 + y*4 + x + 20], C[z*16 + y*4 + x + 21])))
texalu m8 under mm3
# controls: a block that can leave the table's rows (x up to 2 of 3),
# eight entries that are no box (one twice), and gt1030
m9(x: u8 in 0..2, y: u8 in 0..2, z: u8 in 0..1) = max(max(max(Q[z*12 + y*3 + x + 16], Q[z*12 + y*3 + x]), max(Q[z*12 + y*3 + x + 3], Q[z*12 + y*3 + x + 13])), max(max(Q[z*12 + y*3 + x + 12], Q[z*12 + y*3 + x + 1]), max(Q[z*12 + y*3 + x + 15], Q[z*12 + y*3 + x + 4])))
texalu m9 under mm3
m10(x: u8 in 0..1, y: u8 in 0..2, z: u8 in 0..1) = max(max(max(Q[z*12 + y*3 + x + 16], Q[z*12 + y*3 + x]), max(Q[z*12 + y*3 + x + 3], Q[z*12 + y*3 + x + 13])), max(max(Q[z*12 + y*3 + x + 12], Q[z*12 + y*3 + x + 1]), max(Q[z*12 + y*3 + x + 15], Q[z*12 + y*3 + x + 15])))
texalu m10 under mm3
texalu m7
