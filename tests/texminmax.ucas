# A min or max of neighbouring table entries as one read with a MIN or
# MAX reduction sampler (src/texalu.c, seed_minmax): read at the centre
# of the footprint, every weight is non-zero on any sub-texel grid
model texel : gt1030 { tex_nearest: 6.875, subtexel: 8, tex_within: 2 }
model mm : texel { tex_minmax: 8 }
# the operations: the texels whose weight is not 0
show tex_min8([4.0, 1.0, 9.0], 1.0)
show tex_max8([4.0, 1.0, 9.0], 1.0)
show tex_max8([4.0, 1.0, 9.0], 1.5)
show tex_bimax8([1.0, 5.0, 2.0, 7.0, 3.0, 8.0], 3, 2.0, 1.0)
show tex_bimin8([1.0, 5.0, 2.0, 7.0, 3.0, 8.0], 3, 1.25, 1.0)
# two along a row, of floats an f16 holds and of floats it does not
H = [0.5, 1.25, 3.0, 7.5, 2.0, 0.125, 6.0, 1.0]
m1(i: u8 in 0..6) = min(H[i], H[i + 1])
texalu m1 under mm
F = [f32(0.1), f32(0.7), f32(0.33), f32(0.9), f32(0.05)]
m2(i: u8 in 1..3) = max(F[i + 1], F[i])
texalu m2 under mm
# a 2 x 2 block of a table read as rows of 4, nested
P = [3.0, 1.0, 4.0, 1.0, 5.0, 9.0, 2.0, 6.0, 5.0, 3.0, 5.0, 8.0]
m3(x: u8 in 0..2, y: u8 in 0..1) = max(max(P[y*4 + x], P[y*4 + x + 1]), max(P[y*4 + x + 4], P[y*4 + x + 5]))
texalu m3 under mm
# whole numbers 0..255 as normalised bytes, scaled back
B = [10, 200, 30, 40, 250, 6]
m4(i: u8 in 0..4) = min(B[i], B[i + 1])
texalu m4 under mm
# entries that are not neighbours, a pair that can leave the table, and a
# model with no price for the read
m5(i: u8 in 0..5) = min(H[i], H[i + 2])
texalu m5 under mm
m6(i: u8 in 0..7) = min(H[i], H[i + 1])
texalu m6 under mm
texalu m1 under texel
