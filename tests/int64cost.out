> a1(a: u64, b: u64) = a + b
> a2(a: u64, b: u64, c: u64) = a * b + c
> a3(a: u64, k: u64) = (a << 3) + (a >> k)
> a4(a: u64) = a * 8 - a / 4
> a5(a: i64) = a / 4
> a6(a: u32, b: u32, c: u32) = a * b + c
> a7(a: u40, b: u40) = a * b
> a8(a: u64, b: u64) = (a xor b) < a
> a9(a: u64, b: u64) = a ^ b
  note: '^' is power; use 'xor' or '⊕' for exclusive or
