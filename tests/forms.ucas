trig cos(2x) expand
trig tan(a+b) expand
trig sin(x + pi/4) expand
trig sin^3 x reduce
trig sin x cos y product
trig sin x + sin y sum
trig cos(3x) - cos(x) sum
trig 3sin(x) + 4cos(x) harmonic
trig a sin(x) + b cos(x) harmonic
trig tan(x) sec(x) sincos
trig sin(x)^2 + cos(x)^2
trig sin(x/2) half
trig 1/(1 + cos(x)) weierstrass
trig sinh(2x)
trig cosh(x)^2 reduce
trig tanh(x) exp
trig cos(atan(x))
trig sin(asin(x))
trig atan(x) inverse
trig acos(x) inverse
trig atan2(y, x)
trig atan(x) + atan(y) inverse
trig asinh(x)
trig atanh(x)
diff asin(x)
diff atan2(y, x)
domain acos(x/2)

