# Complex, polar and trig forms (src/forms.c).  Inside these commands i
# (also j, I, im) is the imaginary unit and other variables are real;
# every result is parsed back and compared with the original at sample
# points (the original in C's complex arithmetic).

# --- a + bi ---
complex (1+2i)/(3-i)
complex e^(i x)
complex (1+i)^8
rect (2+3i)(4-5i)
complex 1/(x + i y)
complex (x + i y)^2
complex sqrt(-4)
complex sqrt(i)
complex log(-1)
complex i^i
complex sin(x + i y)
complex asin(2)
complex 2 cis(pi/3)
complex 3j - 1
complex 4 + 2im
re e^(x + i y)
im (2+3i)^2
conj (1+2i)/(3-i)
modulus 3+4i
modulus e^(x + i y)
arg 1 + 2i
arg -1 - i
f(x, i) = x + 2i
complex f

# --- polar ---
polar 1 + i
polar -2i
polar -1
polar 3 + 4i
polar x + i y
polar e^(i x)
polar 2∠45°
polar 0

# --- roots ---
nthroots 3 8i
nthroots 4 -16
unity 6
nthroots 2 x + i y

# --- trig rewrites ---
trig sin^2 x
trig sin(x) cos(x)
