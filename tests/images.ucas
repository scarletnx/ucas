# animate exec with images: textures, samplers, derivatives, the whole-image run

animate exec of this seed 1 nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D tex;
layout(binding = 1) uniform texture2D t2;
layout(binding = 2) uniform sampler smp;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() {
	vec4 c = texture(tex, uv) + texelFetch(tex, ivec2(gl_FragCoord.xy), 0);
	c += texture(sampler2D(t2, smp), uv * 2.0);
	float d = dFdx(uv.x) + dFdy(uv.y) + fwidth(c.r);
	mat3 r = mat3(1.0);
	r[1] = vec3(c.xyz) * d;
	vec3 q = transpose(r) * vec3(uv, 1.0);
	if (q.z < 0.0)
		discard;
	vec2 sz = vec2(textureSize(tex, 0));
	o = vec4(q, d) + vec4(sz, 0, 0) + vec4(outerProduct(uv, uv)[0], 0, 0);
	o.xy = mix(o.xy, smoothstep(0.0, 1.0, o.zw), step(0.5, uv));
}
```

# a 5x5 box blur
animate exec of this seed 2 nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D img;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() {
	vec2 px = 1.0 / vec2(textureSize(img, 0));
	vec4 s = vec4(0.0);
	for (int y = -2; y <= 2; y++)
		for (int x = -2; x <= 2; x++)
			s += texture(img, uv + vec2(x, y) * px);
	o = s / 25.0;
}
```

# grayscale of a gradient, into an R8 target
animate exec of this seed 3 input 1 gradient output R8 nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D img;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() {
	vec4 c = texture(img, uv);
	float g = dot(c.rgb, vec3(0.299, 0.587, 0.114));
	o = vec4(g, g, g, 1.0);
}
```

