# a blend of two inputs, one a colour, at 32x32
animate exec of this seed 5 input 1 checker input 2 #ff8800 size 32x32 nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D a;
layout(binding = 1) uniform sampler2D b;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() { o = mix(texture(a, uv), texture(b, uv), 0.5); }
```

# discard: the pixels outside a circle
animate exec of this seed 6 input 1 red nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D img;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() {
	o = texture(img, uv).bgra;
	if (length(uv - 0.5) > 0.4)
		discard;
}
```

# a compute shader on storage images: invert
animate exec of this seed 7 nofile
```glsl
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform readonly image2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	imageStore(dst, p, vec4(1.0) - imageLoad(src, p));
}
```

# image atomics: a histogram of the red channel
animate exec of this seed 8 size 16x16 input 2 black nofile
```glsl
#version 450
layout(local_size_x = 4, local_size_y = 4) in;
layout(binding = 0) uniform sampler2D img;
layout(binding = 1, r32ui) uniform uimage2D hist;
void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	uint r = uint(texelFetch(img, p, 0).r * 15.0);
	imageAtomicAdd(hist, ivec2(r, 0), 1u);
}
```

# explicit LOD, gather, offsets, queries, a shadow compare
animate exec of this seed 9 input 2 gradient input 3 R32F nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D a;
layout(binding = 1) uniform sampler2D b;
layout(binding = 2) uniform sampler2DShadow s;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() {
	vec4 l = textureLod(a, uv, 2.0) + textureGrad(b, uv, vec2(0.1, 0.0), vec2(0.0, 0.1));
	vec4 g = textureGather(b, uv, 1) + textureOffset(a, uv, ivec2(1, -1));
	float d = texture(s, vec3(uv, 0.5));
	vec2 q = textureQueryLod(a, uv);
	o = vec4(l.x + g.y, d, q.x / 8.0, float(textureQueryLevels(a)) / 8.0);
}
```

# texelFetch outside the image: robust, counted
animate exec of this seed 10 size 8x8 nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D a;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() { o = texelFetch(a, ivec2(gl_FragCoord.xy) * 3, 0); }
```

# matrices: inverse, determinant, outer product
animate exec of this seed 11 size 4x4 nofile
```glsl
#version 450
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() {
	mat3 m = mat3(uv.x + 1.0, 0.5, 0.0, 0.25, uv.y + 2.0, 0.0, 0.0, 0.0, 1.0);
	mat3 i = inverse(m);
	o = vec4((i * m)[0][0], determinant(m) / 8.0, outerProduct(uv, uv)[1][1], 1.0);
}
```

# image files: PNG, JPEG, BMP, GIF

animate exec of this seed 12 input 1 file img/ramp8.png input 2 file img/g16.jpg input 3 file img/g16.bmp input 4 file img/g16.gif nofile
```glsl
#version 450
layout(binding = 0) uniform sampler2D a;
layout(binding = 1) uniform sampler2D b;
layout(binding = 2) uniform sampler2D c;
layout(binding = 3) uniform sampler2D d;
layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 o;
void main() { o = (texture(a, uv) + texture(b, uv) + texture(c, uv) + texture(d, uv)) / 4.0; }
```

