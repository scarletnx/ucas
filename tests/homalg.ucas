# Homological algebra: spaces, (co)homology, long exact sequences, the
# Bockstein spectral sequence and Proposition 0.1 of bockstein.pdf

# spaces: cells, Euler characteristic, boundaries
space RP^4
space K
space T^2_s
space RP^2_s
space RP^3_s
space S^2 x RP^3
space L(9)
space cells([[0, 0]], [[0], [2]])

# integral (co)homology; RP^4: Z, 0, Z/2, 0, Z/2
cohomology RP^4
homology RP^4
cohomology RP^4 with Z/2
cohomology RP^4 with Z/3
cohomology RP^5
homology K
homology K_s
homology T^2_s
cohomology T^3
homology RP^2_s
homology RP^3_s
homology S^4_s
cohomology CP^2
cohomology L(9)
cohomology L(9,2) with Z/3
cohomology S^2 x RP^3
homology RP^2 v S^1 v T^2
homology susp(RP^2)
homology susp(susp(K))
homology cells(1, 1, 1: [], [[3]])
homology facets([[0,1,2], [0,2,3], [3,4]])
cohomology K with Z/4 + Z
cohomology K with Z/2 generators
homology T^2_s generators

# long exact sequences, the connecting map by the snake lemma
les RP^2 mod 2
les L(4) mod 2
les K mod 4

# the Bockstein spectral sequence: RP^n at 2 (d_1 only, E_inf = Z/2 in 0,
# and in n when n is odd)
bockstein RP^4 mod 2
bockstein RP^5 mod 2
bockstein RP^2_s mod 2
bockstein RP^4 mod 3
# lens spaces L(p^k): d_k is the first nonzero differential
bockstein L(9) mod 3
bockstein L(9) mod 2
bockstein L(8) mod 2
bockstein L(27) mod 3
bockstein L(12) mod 2
bockstein K mod 2
bockstein K_s mod 2
bockstein S^2 x RP^3 mod 2
bockstein L(4) x L(8) mod 2

# tracing a in H^n(X; Z): j_r(p^(r-1) a), ker d_r, im d_r (a preimage)
bockstein RP^4 mod 2 trace 2
bockstein L(9) mod 3 trace 2
bockstein L(9) mod 3 trace 3
bockstein L(9) mod 3 trace 0 [1] page 5
bockstein T^2 mod 2 trace 1 [1, 1]
bockstein S^2 x RP^3 mod 2 trace 2

# Proposition 0.1: every n, every r (up to the stable page, which covers
# every later one)
prop01 T^2 mod 2
prop01 S^2 x RP^3 mod 2
prop01 L(9) mod 3
prop01 L(27) mod 3
prop01 RP^4 mod 2
prop01 K_s mod 2
prop01 L(4) x L(8) mod 2
bockstein T^2_s mod 3 check

# errors
homology foo
bockstein RP^4 mod 4
bockstein RP^4
les RP^2 mod 1
bockstein L(9) mod 3 trace 3 [1, 2]
homology cells([[1]], [[1]])
homology facets([[0, 0, 1]])
