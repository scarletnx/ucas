> gates mux4 basis avx512 as c
gates for mux4: 6 input bits -> 4 output bits (3 constant), basis avx512
  minimal: cost 3, 3 steps (no program of cost <= 2 exists; 7289084 candidates searched)
  checked: the program reproduces every output bit on all 64 care inputs
  t0 = ternlog(s0, x0, x1, 0x53)       = (~x1 & ~x0 & ~s0) | (~x1 & ~x0 & s0) | (~x1 & x0 & s0) | (x1 & ~x0 & ~s0)
  t1 = ternlog(s0, x2, x3, 0x53)       = (~x3 & ~x2 & ~s0) | (~x3 & ~x2 & s0) | (~x3 & x2 & s0) | (x3 & ~x2 & ~s0)
  t2 = ternlog(s1, t0, t1, 0x53)       = (~t1 & ~t0 & ~s1) | (~t1 & ~t0 & s1) | (~t1 & t0 & s1) | (t1 & ~t0 & ~s1)
  r3 = 0
  r2 = 0
  r1 = 0
  r0 = t2

/* mux4, basis avx512: bits are independent lanes, so the same code also
   runs bit-sliced on whole words */
static inline uint32_t
mux4_gates(uint32_t s, uint32_t x)
{
	uint32_t s0 = s >> 0 & 1;
	uint32_t s1 = s >> 1 & 1;
	uint32_t x0 = x >> 0 & 1;
	uint32_t x1 = x >> 1 & 1;
	uint32_t x2 = x >> 2 & 1;
	uint32_t x3 = x >> 3 & 1;
	uint32_t t0 = ((~x1 & ~x0 & ~s0) | (~x1 & ~x0 & s0) | (~x1 & x0 & s0) | (x1 & ~x0 & ~s0)) & 1;
	uint32_t t1 = ((~x3 & ~x2 & ~s0) | (~x3 & ~x2 & s0) | (~x3 & x2 & s0) | (x3 & ~x2 & ~s0)) & 1;
	uint32_t t2 = ((~t1 & ~t0 & ~s1) | (~t1 & ~t0 & s1) | (~t1 & t0 & s1) | (t1 & ~t0 & ~s1)) & 1;
	return (t2 & 1) << 0;
}
