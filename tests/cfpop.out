  /* optimised by ucas cfront for x86-64-v3 (x86-64-v3); every rewrite proved, see the report */
  /* Kernels of tests/cfpop.ucas. */
  #include <stdint.h>
  
  /* the bits of x, counted in a loop: popcount(x) */
  #if defined(__POPCNT__) || defined(__LZCNT__) || defined(__BMI__)
  #include <immintrin.h>
  #endif
  static inline uint32_t cf_popcount32(uint32_t x)
  {
  #if defined(__POPCNT__)
  	return (uint32_t)_mm_popcnt_u32(x);
  #elif defined(__GNUC__)
  	return (uint32_t)__builtin_popcount(x);
  #else
  	x = x - ((x >> 1) & 0x55555555u);
  	x = (x & 0x33333333u) + ((x >> 2) & 0x33333333u);
  	return (((x + (x >> 4)) & 0x0f0f0f0fu) * 0x01010101u) >> 24;
  #endif
  }
  uint32_t pop_loop(uint32_t x)
  {
  	return (unsigned int)((uint32_t)(cf_popcount32((uint32_t)((x)))));
  }
  
  /* the same sum written out */
  uint32_t pop_sum(uint32_t x)
  {
  	return (unsigned int)((uint32_t)(cf_popcount32((uint32_t)((x)))));
  }
  
  /* the bits of a signed x: of its pattern, the sign's included */
  uint32_t pop_signed(int32_t x)
  {
  	return (unsigned int)((uint32_t)(cf_popcount32((uint32_t)(((uint32_t)((x)))))));
  }
  
  /* two bits a step, not one: no popcount of x */
  uint32_t pop_wide(uint32_t x)
  {
  	uint32_t c = 0;
  	for (int i = 0; i < 32; i++)
  		c += (x >> i) & 3;
  	return c;
  }
  
  /* the two lowest bits alone */
  uint32_t pop_two(uint32_t x)
  {
  	uint32_t c = 0;
  	for (int i = 0; i < 2; i++)
  		c += (x >> i) & 1;
  	return c;
  }
  
  /* it leaves at the first zero: the ones below it, not all of them */
  uint32_t pop_until(uint32_t x)
  {
  	uint32_t c = 0;
  	for (int i = 0; i < 8; i++) {
  		if (!((x >> i) & 1))
  			break;
  		c += (x >> i) & 1;
  	}
  	return c;
  }
