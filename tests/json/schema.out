ng part (files)", "ucas": "neighbourhood", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "at", "type": "number", "required": false, "description": "the point"}, {"name": "nofile", "type": "boolean", "required": false, "description": "a checksum instead of the file"}]}, {"cmd": "animate", "description": "an animated GIF: scans, lockstep execution (files)", "ucas": "animate", "structured": false, "params": [{"name": "spec", "type": "string", "required": false, "description": "as in the CLI: \"hillis scan n 8\", \"exec of 32-bit x*x + 1\""}, {"name": "code", "type": "source", "required": false, "description": "SPIR-V assembly for animate exec"}]}, {"cmd": "symmetry", "description": "axes x = c, centres, f(x, y) = f(y, x)", "ucas": "symmetry", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "ring", "description": "a ring's structure (units, zero divisors, ideals ...), an element of it, or a value computed in it", "ucas": "ring", "structured": true, "params": [{"name": "ring", "type": "ring", "required": true, "description": "Z/12, GF(2^8), GF(2)[x]/(x^4 + 1), Z[i], Q[x]/(x^2 - 2) ..."}, {"name": "modulus", "type": "modulus", "required": false, "description": "N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)"}, {"name": "what", "type": "string", "required": false, "description": "units | zero divisors | idempotents | table, an element (\"4\", \"0x53\"), or an expression (\"0x57 * 0x83\")"}]}, {"cmd": "inverse_mod", "description": "a multiplicative inverse (of a number, an element, a matrix)", "ucas": "inverse", "structured": true, "params": [{"name": "a", "type": "string", "required": true, "description": "th