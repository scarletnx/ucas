d name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "crit", "description": "critical points, extrema, inflection points", "ucas": "crit", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "diff", "description": "derivative (higher, partial, mixed)", "ucas": "diff", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "vars", "type": "names", "required": false, "description": "variables, in order (x y: d2/dydx)"}, {"name": "order", "type": "integer", "required": false, "description": "the order"}]}, {"cmd": "grad", "description": "the gradient", "ucas": "grad", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "at", "type": "expressions", "required": false, "description": "a point"}]}, {"cmd": "hessian", "description": "the Hessian (and at a point the second-derivative test)", "ucas": "hessian", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "at", "type": "expressions", "required": false, "description": "a point"}]}, {"cmd": "laplacian", "description": "the Laplacian", "ucas": "laplacian", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "at", "type": "expressions", 