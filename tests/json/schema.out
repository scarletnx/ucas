plicit", "structured": true, "params": [{"name": "equation", "type": "expression", "required": true, "description": "L = R"}, {"name": "for", "type": "name", "required": false, "description": "y"}, {"name": "wrt", "type": "name", "required": false, "description": "x"}, {"name": "order", "type": "integer", "required": false, "description": "1 or 2"}]}, {"cmd": "integrate", "description": "antiderivative (checked by differentiating back) or definite integral", "ucas": "integrate", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "var", "type": "name", "required": false, "description": "the variable of integration"}, {"name": "from", "type": "number", "required": false, "description": "lower bound (with to)"}, {"name": "to", "type": "number", "required": false, "description": "upper bound (with from)"}, {"name": "around", "type": "string", "required": false, "description": "a contour for a complex integrand: \"|z| = 1\""}]}, {"cmd": "antiderivative", "description": "an antiderivative + C", "ucas": "antiderivative", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "var", "type": "name", "required": false, "description": "the variable"}]}, {"cmd": "equiv", "description": "equal on F's domain? (with a counterexample)", "ucas": "equiv", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "g", "type": "function", "required": true, "description": "the other function"}]}, {"cmd": "find", "description": "cheaper implementations under the cost model", "ucas": "find", "