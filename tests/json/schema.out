ams\"}"}, {"name": "basis", "type": "name", "required": false, "description": "c, a64, a64sha, x86bmi, nand ..."}, {"name": "max", "type": "integer", "required": false, "description": "maximum cost (12)"}, {"name": "nodes", "type": "integer", "required": false, "description": "search budget"}, {"name": "as_c", "type": "boolean", "required": false, "description": "also a C function"}]}, {"cmd": "approx", "description": "polynomial/rational approximations, measured", "ucas": "approx", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "in", "type": "interval", "required": false, "description": "the interval"}, {"name": "options", "type": "string", "required": false, "description": "approx options as in the CLI: \"degree 5 as f64 keep endpoints\""}]}, {"cmd": "approx_more", "description": "more candidates of the last approx", "ucas": "approx more", "structured": true, "params": [{"name": "n", "type": "integer", "required": false, "description": "how many"}]}, {"cmd": "closed", "description": "closed forms of sums, products, loops", "ucas": "closed", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "scheme", "description": "evaluation schemes priced", "ucas": "scheme", "structured": false, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "model", "type": "name", "required": false, "description": "the model"}]}, {"cmd": "continuous", "description": "sums as integrals, loops as ODEs", "ucas": "continuous", "structured": false, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "dsolve", "description": "solve a defined ODE (symbolic or numeric)", "ucas": "dsolve", "structured": true, "params": [{"name": "name", "type": "name", "required": true, "description": "the ODE's function"}, {"name": "from", "type": "number", "required": false, "description": "start"}, {"name": "to", "type": "number", "required": false, "description": "end"}, {"name": "steps", "type": "integer", "required": false, "description": "steps to print"}]}, {"cmd": "complex", "description": "as a + bi", "ucas": "complex", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "re", "description": "the real part", "ucas": "re", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "im", "description": "the imaginary part", "ucas": "im", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "conj", "description": "the conjugate", "ucas": "conj", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "modulus", "description": "the modulus", "ucas": "modulus", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"