{"id": 1, "cmd": "ucas", "args": {"source": "model cal : gt1030 { tex_nearest: 5, tex_within: 2 }\nK = [10, 20, 30, 40, 50, 60, 70]\nB = [3, 9, 27, 81, 243, 1, 200, 100, 50, 25, 12, 6, 0, 255, 128, 64]"}}
{"id": 2, "cmd": "texalu", "args": {"f": {"body": "K[i % 7]", "params": [{"name": "i", "type": "u16", "range": [0, 1000]}]}, "model": "cal"}}
