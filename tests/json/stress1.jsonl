{"id": 1, "cmd": "ucas", "args": {"source": "q(x: i32, y: i32) = x / y\nq0(x: i32, y: i32) = y == 0 ? 7 : x / y\nwiden(v: u32, n: u32 in 5..8) = n == 8 ? v : ((v << (8 - n)) | (v >> (2*n - 8))) & 0xFF where v < 1 << n\nwiden2(v: u32, n: u32 in 5..8) = ((v << (8 - n)) | (v >> (2*n - 8))) & 0xFF where v < 1 << n"}}
{"id": 2, "cmd": "equiv", "args": {"f": "q", "g": "q0"}}
{"id": 3, "cmd": "equiv", "args": {"f": "q0", "g": "q"}}
{"id": 4, "cmd": "equiv", "args": {"f": "widen", "g": "widen2"}}
{"id": 5, "cmd": "find", "args": {"f": {"name": "cl", "body": "min(max(u32(x) >> s, 0), 255) & 0xFF", "params": [{"name": "x", "type": "u8"}, {"name": "s", "type": "u8", "range": [0, 3]}]}, "n": 1}}
{"id": 6, "cmd": "ucas", "args": {"source": "quant(v: i32 in 0..255) = { best = 0; berr = 100000; q0 = (v * 31 + 127) / 255; for d in -2..2 { q = q0 + d; qc = q < 0 ? 0 : q > 31 ? 31 : q; r = (qc << 3) | (qc >> 2); e = (r - v) * (r - v); if e < berr { berr = e; best = qc } }; best }"}}
{"id": 7, "cmd": "cost", "args": {"f": "quant"}}
{"id": 8, "cmd": "cost", "args": {"f": {"name": "tri", "body": "{ s: u32 = 0; for i in 1..n/k { s += i*i }; s }", "params": [{"name": "n", "type": "u32", "range": [0, 1000]}, {"name": "k", "type": "u32", "range": [1, 4]}]}}}
{"id": 9, "cmd": "table", "args": {"f": "(x: u16)*3+1", "max": 4000}}
{"id": 10, "cmd": "ucas", "args": {"source": "t64(t: int in 0..260100, dd: int in 1..260100) = (t*64 + dd/2)/dd where t <= dd"}}
{"id": 11, "cmd": "range", "args": {"f": "t64"}}
{"id": 12, "cmd": "ucas", "args": {"source": "wref(i: u32 in 0..15, ib: u32 in 2..4) = (i * 64 + ((1 << ib) - 1) / 2) / ((1 << ib) - 1) where i < 1 << ib"}}
{"id": 13, "cmd": "find", "args": {"f": "wref", "n": 1}}
