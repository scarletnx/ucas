{"id": 20, "ok": true, "cmd": "models", "ucas": "models", "structured": false, "result": {"text": "model gt1030 (active) { iadd: 1, logic: 1, shift: 2, imul: 3, idiv: 28.5, idivk: 8.75, cmp: 2.375, select: 1.625, minmax: 1, bitcnt: 3, conv: 3, bitcast: 0, fadd: 1, fmul: 1, fdiv: 3, fsqrt: 4, ftrans: 4, fpow: 8, f64: 32.375, load: 6.875, branch: 6.25, diverge: 14.375, barrier: 9.125, atomic_shared: 6.625, atomic_global: 50, store: 15, sdiv: 36, sdivk: 21, irem: 32.25, iremk: 13.5, srem: 39.75, sremk: 25.75, dot4x8: 1, dot4x8sat: 6.5, load_shared: 3, store_shared: 3, load_ubo: 4.125, load_ubo_div: 148.125, load_stream: 80.625, store_stream: 111, bank_conflict: 4, atomic_shared_same: 63.75, atomic_shared_f: 24.25, atomic_global_f: 138.75, atomic_global_64: 264.625, atomic_global_cas: 143.5, atomic_global_stream: 137.5, tex_fetch: 43.125, tex_sample: 21.625, tex_sample_f32: 54.75, image_load: 31.875, tex_nearest: 21.625, tex_sample_8: 15, banks: 32, bank_bytes: 4, warp: 32, subtexel: 8, sg_ballot: 1.5, sg_vote: 2, sg_add: 32.625, sg_shuffle: 4, sg_scan: 60.25, sg_deriv: 3.25, bfe: 1.25, brev: 1.25, funnel: 8.125, sad4x8: 15.25, byteperm: 1, mulwide: 13, iadd64: 2, imul64: 15.5, shift64: 3, sg_min: 31.125, sg_cluster4: 19.5, sg_partition: 54.5, sg_partadd: 65.125, sg_barrier: 1.375 }\n  fuse shfl_xor(v: any, lane: lane, k: const) = sg_shuffle(v, lane xor k) : sg_shuffle\n  fuse shfl_rot(v: any, lane: lane, d: const, w: const) = sg_shuffle(v, (lane + d) % w) : sg_shuffle\n  fuse ballot_bit(a: int) = sg_ballot(a & 1 != 0) : 2.625\n  fuse lop3 = lut 3 : logic\n  fuse imad(a: int, b: int, c: int) = a*b + c : imul\n  fuse shl_add(a: int, k: const, b: int) = (a << k) + b : shift\n  fuse shr_add(a: int, k: const, b: int) = (a >> k) + b : shift\n  fuse ffma(a: float, b: float, c: float) = a*b + c : fmul contract\n  fuse ffms(a: float, b: float, c: float) = a*b - c : fmul contract\n  fuse ffmr(a: float, b: float, c: float) = c - a*b : fmul contract\n  fuse fneg(a: float) = -a : 0