{"id": 1, "cmd": "cost", "args": {"f": "bfe(x: u32, 8, 8) + brev(x)"}}
{"id": 2, "cmd": "find", "args": {"f": {"body": "(x >> 8) & 255", "params": [{"name": "x", "type": "u32"}]}, "n": 1}}
