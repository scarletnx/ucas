{"id": 1, "cmd": "stoke", "args": {"f": {"name": "xr", "body": "(x | y) - (x & y)", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}, "steps": 50000, "restarts": 2, "seed": 5}}
{"id": 2, "cmd": "define", "args": {"name": "pa", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}], "body": "(x + y) * (x + y)"}}
{"id": 3, "cmd": "define", "args": {"name": "pb", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}], "body": "x * x + 2 * x * y + y * y"}}
{"id": 4, "cmd": "pit", "args": {"f": "pa", "g": "pb", "trials": 2}}
{"id": 5, "cmd": "equiv", "args": {"f": "pa", "g": "pb"}}
{"id": 6, "cmd": "phash", "args": {"f": {"name": "days", "body": "match m { 2 => 28, 4 | 6 | 9 | 11 => 30, 1 | 3 | 5 | 7 | 8 | 10 | 12 => 31, _ => 0 }", "params": [{"name": "m", "type": "u8", "range": [1, 12]}]}}}
{"id": 7, "cmd": "cost", "args": {"f": {"name": "t", "body": "i < 16000 ? exp(y) * sqrt(y) : y", "params": [{"name": "i", "type": "u32", "range": [0, 32767]}, {"name": "y", "type": "f32"}]}, "consecutive": "i"}}
