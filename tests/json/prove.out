{"id": 1, "ok": true, "cmd": "theorem", "ucas": "theorem bockstein: forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C,n) and zsummand(a,H(C,n)) -> Zr(bock(C,p),r,j(bock(C,p),a)) and dzero(bock(C,p),r,j(bock(C,p),a)) and not dimg(bock(C,p),r,n-1,j(bock(C,p),a))", "structured": true, "result": {"kind": "theorem", "name": "bockstein", "statement": "forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C, n) and zsummand(a, H(C, n)) -> Zr(bock(C, p), r, j(bock(C, p), a)) and dzero(bock(C, p), r, j(bock(C, p), a)) and not dimg(bock(C, p), r, n - 1, j(bock(C, p), a))"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "theorem bockstein: forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C, n) and zsummand(a, H(C, n)) -> Zr(bock(C, p), r, j(bock(C, p), a)) and dzero(bock(C, p), r, j(bock(C, p), a)) and not dimg(bock(C, p), r, n - 1, j(bock(C, p), a))\n"}
{"id": 2, "ok": true, "cmd": "prove", "ucas": "prove bockstein", "structured": true, "result": {"kind": "prove", "name": "bockstein", "statement": "forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C, n) and zsummand(a, H(C, n)) -> Zr(bock(C, p), r, j(bock(C, p), a)) and dzero(bock(C, p), r, j(bock(C, p), a)) and not dimg(bock(C, p), r, n - 1, j(bock(C, p), a))", "routes": [{"lemma": "bockstein_paper", "inferences": 6945, "rechecked": true}, {"lemma": "bockstein_coords", "inferences": 6176, "rechecked": true}], "proved": true}, "notes": [], "conditions": [], "checks": [], "proof": {"kind": "kernel", "text": "LCF kernel proof, re-checked by kcheck.c"}, "files": [], "text": "bockstein: forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C, n) and zsummand(a, H(C, n)) -> Zr(bock(C, p), r, j(bock(C, p), a)) and dzero(bock(C, p), r, j(bock(C, p), a)) and not dimg(bock(C, p), r, n - 1, j(bock(C, p), a))\n  proved by bockstein_paper (6945 kernel inferences with its lemmas); independent re-check: ok\n  proved by bockstein_coords (6176 kernel inferences with its lemmas); independent re-check: ok\n"}
