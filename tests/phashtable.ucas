# phash's two-level hash: for these fifty 16-bit keys none of the one-level
# hashes tried (masks and shifts, 4000 multipliers of each kind, tables up
# to 8 times the keys) is injective, so the hash with a displacement table
# (a second multiply and a load) is the cheapest proved one
big(x: u16) = match x { 13498 => 1, 32534 => 2, 44591 => 3, 34847 => 4, 28023 => 5, 50937 => 6, 20588 => 7, 30514 => 8, 38376 => 9, 60519 => 10, 29700 => 11, 23697 => 12, 19646 => 13, 16281 => 14, 52061 => 15, 11782 => 16, 45810 => 17, 51107 => 18, 15998 => 19, 5365 => 20, 37646 => 21, 19678 => 22, 34420 => 23, 32448 => 24, 57354 => 25, 22511 => 26, 47805 => 27, 29415 => 28, 18871 => 29, 39909 => 30, 64237 => 31, 4798 => 32, 7738 => 33, 33551 => 34, 27403 => 35, 10811 => 36, 49620 => 37, 22417 => 38, 9961 => 39, 61163 => 40, 32045 => 41, 27637 => 42, 2570 => 43, 63047 => 44, 43793 => 45, 5087 => 46, 50107 => 47, 36575 => 48, 37554 => 49, 51715 => 50, _ => 0 }
phash big
