      uint Quant(int t, uint p) {
          const uint n = StoredBits();
          const uint top = (1u << n) - 1u;
          const int guess = (t * int(top) + 127) / 255;
          uint best = 0u;
          int best_d = 1000;
          for (int d = -1; d <= 1; d++) {
              const int c = guess + d;
              if (c < 0) {
                  continue;
              }
              if (sh_pk != 0u && (uint(c) & 1u) != p) {
                  continue;
              }
              const int e = int(Widen(uint(c), n)) - t;
              const int a = e < 0 ? -e : e;
              if (a < best_d) {
                  best_d = a;
                  best = uint(c);
              }
          }
          return best;
      }
