# The sink: the format a stored float ends in sets the error budget of
# float simplify (src/fsimp.c, sink_pass): one step of the format at the
# root, carried to each rewrite through the operations between.
# sRGB to linear into an 8-bit UNORM target: the pow becomes the
# cheapest polynomial whose error, carried to the stored value with the
# other rewrites', stays within one step (1/255)
simplify float c in [0, 1] sink unorm8 nofile
```glsl
vec3 ToLinear(vec3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c)); }
```
# no sink: the polynomials are only listed
simplify float c in [0, 1] nofile
```glsl
vec3 Gamma(vec3 c) { return pow((c + 0.055) / 1.055, vec3(2.4)); }
```
# 16 bits: no polynomial cheaper than the pow is within 1/65535
simplify float c in [0, 1] sink unorm16 nofile
```glsl
vec3 Gamma(vec3 c) { return pow((c + 0.055) / 1.055, vec3(2.4)); }
```
# the value is scaled by 3 after the pow: the budget at the pow is a
# third of a step, and the degree that fitted above no longer does
simplify the floats, c in [0, 1], for an RGBA8_UNORM target nofile
```glsl
vec3 Gamma(vec3 c) { return pow((c + 0.055) / 1.055, vec3(2.4)) * 3.0 - 1.0; }
```
# a 16-bit float target: a step is 2^-11 of the value, so the range
# must keep the value away from 0
simplify float c in [0.25, 1] sink f16 nofile
```glsl
vec3 Gamma(vec3 c) { return pow((c + 0.055) / 1.055, vec3(2.4)); }
```
simplify float c in [0, 1] sink f16 nofile
```glsl
vec3 Gamma(vec3 c) { return pow(c, vec3(2.4)); }
```
# a model where pow is cheap: no polynomial is cheaper, the sink changes
# nothing
model powcheap : gt1030 { fpow: 2 }
use powcheap
simplify float c in [0, 1] sink unorm8 nofile
```glsl
vec3 Gamma(vec3 c) { return pow((c + 0.055) / 1.055, vec3(2.4)); }
```
use gt1030
# an image store: the sink is the image's format, and a clamp bounds
# what follows it
simplify float nofile
```glsl
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform writeonly image2D dst;
layout(binding = 1, rgba16f) uniform readonly image2D src;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec4 c = clamp(imageLoad(src, p), 0.0, 1.0);
    vec3 enc = pow(c.rgb * 0.75 + 0.125, vec3(0.45));
    imageStore(dst, p, vec4(enc, c.a));
}
```
# a format with f32's bits is not a sink
simplify float c in [0, 1] sink rgba32f nofile
```glsl
vec3 Gamma(vec3 c) { return pow(c, vec3(2.4)); }
```
