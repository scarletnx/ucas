# A parameter with its own value in each lane, `x: u32 lanes` (src/sg.c):
# W free words, one per lane.  In the lane itself x is the lane's word; a
# subgroup operation reads every lane's.  There is no one point to
# evaluate, so equiv and find decide by SAT over the lanes' words.
model w8 : gt1030 { warp: 8 }
use w8

# a ballot of the lanes' low bits, and the same word put together from
# shuffles
bl(x: u8 lanes, lane: u32 in 0..7) = sg_ballot((x & 1) != 0)
bs(x: u8 lanes, lane: u32 in 0..7) = { r: u32 = 0; for j in 0..7 { r = r | (u32(sg_shuffle(x, j) & 1) << j) }; r }
equiv bl bs
# a wrong one, the bits in the other order: SAT's counterexample is the
# lanes' words, run again by the evaluator
bw(x: u8 lanes, lane: u32 in 0..7) = { r: u32 = 0; for j in 0..7 { r = r | (u32(sg_shuffle(x, j) & 1) << (7 - j)) }; r }
equiv bl bw
# the lane's own word is the one a shuffle reads at the lane
own(x: u8 lanes, lane: u32 in 0..7) = x
shf(x: u8 lanes, lane: u32 in 0..7) = sg_shuffle(x, lane)
equiv own shf
# no range to walk and no call to pass the lanes' values, each said; the
# price is that of a value computed in the lane
range bl
show bl(3, 2)
cost bl
# refused: a lanes parameter that is uniform too, one that is not a
# machine integer, one read in the lane itself by a function with no lane
u2(x: u8 uniform lanes) = x
fl(x: f32 lanes) = x
nol(x: u8 lanes) = x + sg_shuffle(x, 0)
nol2(x: u8 lanes) = sg_shuffle(x, 0)
equiv nol nol2

# the transpose of the lanes' words as a matrix of bits (8 words of 8
# bits): lane j gets the word whose bit l is bit j of lane l's word.
# Read by eight shuffles, and as the ballot of bit j kept by lane j
# (`equiv tr tb` proves them equal; SAT's conflict count for it depends
# on the compiler, 128 with gcc and 131 with clang, so it is not run
# here)
tr(x: u8 lanes, lane: u32 in 0..7) = { r: u32 = 0; for l in 0..7 { r = r | (u32((sg_shuffle(x, l) >> lane) & 1) << l) }; r }
tb(x: u8 lanes, lane: u32 in 0..7) = { r: u32 = 0; for j in 0..7 { r = lane == j ? sg_ballot(((x >> j) & 1) != 0) : r }; r }
cost tr
cost tb

# a sum of two 64-bit numbers, a byte in each of 8 lanes, the carry
# worked out lane by lane from the lanes below ...
wadd(a: u8 lanes, b: u8 lanes, lane: u32 in 0..7) = { c: u8 = 0; for j in 0..6 { aj = sg_shuffle(a, j); sj = u8(aj + sg_shuffle(b, j) + c); c = j < lane ? (sj < aj || (c != 0 && sj == aj) ? 1 : 0) : c }; u8(a + b + c) }
# ... is one add of two ballots: find derives it from the shape a + b +
# (something that reads the other lanes) and SAT proves it
find wadd 1
# limbs of 4 bits in a byte: the sum under a mask
wadd4(a: u8 in 0..15 lanes, b: u8 in 0..15 lanes, lane: u32 in 0..7) = { c: u8 = 0; for j in 0..6 { sj = u8(sg_shuffle(a, j) + sg_shuffle(b, j) + c); c = j < lane ? sj >> 4 : c }; (a + b + c) & 15 }
find wadd4 1
# the same shape, not a carry (the lanes below that are odd, counted):
# the guess is dropped by SAT and nothing is offered
notadd(a: u8 lanes, b: u8 lanes, lane: u32 in 0..7) = u8(a + b + u8(popcount(sg_ballot((a & 1) != 0) & ((1 << lane) - 1))))
find notadd 1
# a carry that a dear ballot makes dearer than the loop: said
model dearb : w8 { sg_ballot: 400 }
use dearb
find wadd 1
use w8

# 1024 bits: a u32 in each of 32 lanes
use gt1030
big(a: u32 lanes, b: u32 lanes, lane: u32 in 0..31) = { c: u32 = 0; for j in 0..30 { aj = sg_shuffle(a, j); sj = aj + sg_shuffle(b, j) + c; c = j < lane ? (sj < aj || (c != 0 && sj == aj) ? 1 : 0) : c }; a + b + c }
find big 1

# a loop in an operation's operand that reads x by shuffles: its x are
# read in the inner shuffle's lanes, not in the outer operand's (#429:
# SAT took lane 1's word for both, and proved s1 equal to 2 x1)
model w4 : gt1030 { warp: 4 }
use w4
s1(x: u8 lanes, lane: u32 in 0..3) = sg_shuffle({ w: u32 = 0; for i in 0..1 { w = w + u32(sg_shuffle(x, i)) }; w }, 1)
s2(x: u8 lanes, lane: u32 in 0..3) = u32(sg_shuffle(x, 0)) + u32(sg_shuffle(x, 1))
s3(x: u8 lanes, lane: u32 in 0..3) = u32(sg_shuffle(x, 1)) + u32(sg_shuffle(x, 1))
equiv s1 s2
equiv s1 s3
