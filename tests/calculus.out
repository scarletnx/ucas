> osc(n: int in 0..1000) = {
    x = 1.0; v = 0.0
    for i in 1..n {
      v += 0.01 * (-x)
      x += 0.01 * v
    }
    x
  }
> continuous osc
loop(i in 1..n; v = 0 then v + -0.01*x; x = 1 then x + 0.01(v + -0.01*x)).x
