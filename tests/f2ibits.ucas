# iN(x) of a whole x by the bits (#165, ifx.c's identity in SPIR-V): for x
# made by floor, ceil, round or trunc, a whole number with |x| below 2^22
# (one unit of margin each side for what the float pass may move under
# it), asint(x + 1.5*2^23) - 0x4B400000 is x: the add is exact and reads
# the integer into the mantissa.  The range comes from clamps, min and
# max, constants, adds and multiplies, and the float assumptions; under
# gt1030 a conversion is 3, the add, the bitcast and the subtract 2.  A
# floor of an unbounded value stays a conversion.
simplify nofile nofunctions under gt1030
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { float f[]; } b;
layout(std430, binding = 1) buffer O { int o[]; } o;
layout(std430, binding = 2) buffer U { uint u[]; } u;
void main() {
    uint i = gl_GlobalInvocationID.x;
    float c = b.f[i];
    o.o[i] = int(floor(clamp(c, 0.0, 1.0) * 255.0 + 0.5));
    o.o[i + 64u] = int(floor(c));
    o.o[i + 128u] = int(round(clamp(c, -1.0, 1.0) * 4096.0));
    u.u[i] = uint(ceil(min(max(c, 0.0), 1.0) * 100.0));
}
```
# a float assumption gives the range too
simplify nofile nofunctions under gt1030, t in [0, 1000]
```glsl
#version 450
layout(local_size_x = 64) in;
layout(binding = 0) uniform P { float t; } p;
layout(std430, binding = 1) buffer O { int o[]; } o;
void main() {
    uint i = gl_GlobalInvocationID.x;
    o.o[i] = int(floor(p.t * 16.0)) + int(i);
}
```
