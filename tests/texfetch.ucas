# A texel fetch (src/texalu.c; issue #100): texelFetch takes an integer
# index with no sampler and no address mode, so fetch_texel(T, i) (a
# texture, priced tex_fetch) and fetch_buffer(T, i) (a buffer texture,
# priced tex_buffer) are T[i], undefined outside the table as the read is.
show fetch_texel([10, 20, 30], 1)
show fetch_buffer([10, 20, 30], 2)
show fetch_buffer([10, 20, 30], 3)
show fetch_texel([10, 20, 30], -1)
K = [10, 20, 30, 40, 50, 60, 70]
ft(i: u8 in 0..9) = fetch_buffer(K, i)
domain ft
rk(i: u8 in 0..6) = K[i]
fk(i: u8 in 0..6) = fetch_buffer(K, i)
equiv rk fk
# a negative control: the next texel is not the read
fn(i: u8 in 0..5) = fetch_buffer(K, i + 1)
rn(i: u8 in 0..5) = K[i]
equiv rn fn
# an index of the wrong kind, an argument too many
show fetch_texel(K, 0.5)
show fetch_buffer(K, 1, 2)

# priced by its class alone: no coordinate to make.  gt1030 measured a
# texel fetch (43.125) and lists no buffer texture's
cost fk
model buf : gt1030 { tex_buffer: 5 }
use buf
cost fk
use gt1030

# a plain read through it, where the model prices it below the load:
# never under gt1030 (6.875 against 43.125), under a load that streams
# (gt1030 measured 90), and with a buffer texture's price
r1(i: u8 in 0..6) = K[i] + 1
texalu r1
model stream : gt1030 { load: 90 }
texalu r1 under stream
texalu r1 under buf
# float entries an f16 holds
F = [0.5, 1.25, 3.0]
r3(i: u8 in 0..2) = F[i] * 2
texalu r3 under buf
# an index written as an address mode: the nearest read drops the
# remainder where the model lists it; the fetch keeps it
r2(i: u16 in 0..1000) = K[i % 7]
texalu r2 under buf
model both : buf { tex_nearest: 5, tex_within: 2 }
texalu r2 under both
# a function as its table (tests/textable.ucas): the texel fetch needs
# no coordinate, so with the two at one price it is the cheaper read
bc(i: u32 in 0..15, m: u32 in 1..15) = ((i*64 + m/2)/m*7 + 3)/5
model sb : stream { tex_buffer: 20 }
texalu bc under sb
model three : stream { tex_nearest: 5, tex_buffer: 5 }
texalu bc under three
# under the measured prices alone: the texture's texel fetch against a
# streaming load, for a function dearer than it
bd(i: u32 in 0..15, m: u32 in 1..15) = ((i*64 + m/2)/m*7 + 3)/5 % 11
texalu bd under stream
texalu bd
