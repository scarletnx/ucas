> qb(v: i32 in 0..255, b: i32 in 4..7) = {
    m = (1 << b) - 1
    q = (v * m + 127) / 255
    up = q < m ? q + 1 : q
    dn = q > 0 ? q - 1 : q
    rq = (q << (8 - b)) | (q >> (2*b - 8))
    ru = (up << (8 - b)) | (up >> (2*b - 8))
    rd = (dn << (8 - b)) | (dn >> (2*b - 8))
    eq = (rq - v) * (rq - v)
    eu = (ru - v) * (ru - v)
    ed = (rd - v) * (rd - v)
    eu < eq && eu <= ed ? up : ed < eq ? dn : q
  }
> show qb
qb(v: i32 in 0..255, b: i32 in 4..7) = t3*t3 < t2*t2 && t3*t3 <= t4*t4 ? up : t4*t4 < t2*t2 ? dn : q where m = (1 << b) - 1, q = (v*m + 127)/255, up = q < m ? q + 1 : q, dn = q > 0 ? q - 1 : q, t1 = 2b - 8, t2 = (q << 8 - b | q >> t1) - v, t3 = (up << 8 - b | up >> t1) - v, t4 = (dn << 8 - b | dn >> t1) - v
  -> i32
> cost qb
