# The texture unit at the function level of simplify (src/glslfn.c,
# search_tex): a constant array's read, or a sum of its neighbours, over
# the values the index takes at the calls, proposed with what the
# pipeline needs.  Under gt1030 as measured nothing is proposed.
model cal : gt1030 { tex_nearest: 5, tex_within: 2 }
use cal
simplify nofile
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
const uint K[7] = uint[7](10u, 20u, 30u, 40u, 50u, 60u, 70u);
const uint Q[16] = uint[16](3u, 9u, 27u, 81u, 243u, 1u, 200u, 100u, 50u, 25u, 12u, 6u, 0u, 255u, 128u, 64u);
uint wrapped(uint i) { return K[i % 7u]; }
uint box(uint x, uint y) { return Q[y*4u + x] + Q[y*4u + x + 1u] + Q[y*4u + x + 4u] + Q[y*4u + x + 5u]; }
void main() {
  uint i = gl_GlobalInvocationID.x;
  b.d[i] = wrapped(i & 1023u) + box(i & 1u, (i >> 1) & 1u);
}
```

simplify under gt1030 nofile
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
const uint K[7] = uint[7](10u, 20u, 30u, 40u, 50u, 60u, 70u);
uint wrapped(uint i) { return K[i % 7u]; }
void main() {
  uint i = gl_GlobalInvocationID.x;
  b.d[i] = wrapped(i & 1023u);
}
```
