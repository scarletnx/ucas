# a byte swap is not a reversal: no OpBitReverse (it would fail the
# random runs before the proof)
simplify nofile nofunctions under cat
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = b.d[i];
    b.d[i] = (x >> 24) | ((x >> 8) & 0xff00u) | ((x << 8) & 0xff0000u) | (x << 24);
}
```
# a field put into a word, (base & ~m) | ((v << p) & m) and (base & ~m)
# | ((v & 2^n - 1) << p): one OpBitFieldInsert each
simplify nofile nofunctions under cat
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint w = b.d[i], v = b.d[i + 64u];
    b.d[i] = (w & 0xffff00ffu) | ((v << 8) & 0x0000ff00u);
    b.d[i + 128u] = (w & 0xfffc0fffu) | ((v & 63u) << 12);
}
```
# the high word of a product made 64 bits wide: OpUMulExtended or
# OpSMulExtended of the 32-bit operands (a constant that fits counts as
# either extension), its high member, and a right shift by what the shift
# takes past it; a shift below 32 needs the low word too, and one signed
# operand with one unsigned has no such instruction: those two stay
simplify nofile nofunctions under gt1030
```glsl
#version 450
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
layout(std430, binding = 1) buffer S { int s[]; } c;
layout(std430, binding = 2) readonly buffer R { uint r[]; } a;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = a.r[i], y = a.r[i + 64u];
    int p = int(a.r[i + 128u]), q = int(a.r[i + 192u]);
    b.d[i] = uint((uint64_t(x) * uint64_t(y)) >> 32);
    b.d[i + 64u] = uint((uint64_t(x) * 0xAAAAAAABul) >> 33);
    c.s[i] = int((int64_t(p) * int64_t(q)) >> 32);
    c.s[i + 64u] = int((int64_t(p) * -7l) >> 34);
    c.s[i + 128u] = int((int64_t(p) * int64_t(q)) >> 16);
    c.s[i + 192u] = int((int64_t(p) * int64_t(uint64_t(x))) >> 32);
}
```
# a model that lists mulhi: Op[US]MulExtended at its price
model catm : gt1030 { mulhi: 4 }
simplify nofile nofunctions under catm
```glsl
#version 450
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
layout(std430, binding = 2) readonly buffer R { uint r[]; } a;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = a.r[i], y = a.r[i + 64u];
    b.d[i] = uint((uint64_t(x) * uint64_t(y)) >> 32);
}
```
