# simplify writes the catalogue's SPIR-V instructions and prices them by
# the catalogue's classes where the model lists them (bfe, bfi, brev,
# mulhi), by what it priced them before where it does not.
model cat : gt1030 { bfe: 1, brev: 1, bfi: 1 }
#
# The bits of one word reversed by five swaps: one OpBitReverse (gt1030
# lists no brev: priced as its bit count class); and a field of an int
# by a shift left and an arithmetic shift right: OpBitFieldSExtract,
# which a driver does too
simplify nofile nofunctions under gt1030
```glsl
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; } b;
layout(std430, binding = 1) buffer S { int s[]; } c;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = b.d[i];
    x = ((x >> 1) & 0x55555555u) | ((x & 0x55555555u) << 1);
    x = ((x >> 2) & 0x33333333u) | ((x & 0x33333333u) << 2);
    x = ((x >> 4) & 0x0f0f0f0fu) | ((x & 0x0f0f0f0fu) << 4);
    x = ((x >> 8) & 0x00ff00ffu) | ((x & 0x00ff00ffu) << 8);
    x = (x >> 16) | (x << 16);
    b.d[i] = x;
    c.s[i] = (c.s[i] << 8) >> 20;
}
```
