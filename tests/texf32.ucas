# a texel fetch of an image whose type holds f32 texels: a sampled read
# of those costs tex_sample_f32, above the fetch, so none is offered
simplify nofile
```spv
; SPIR-V
; Version: 1.3
; Generator: Khronos Glslang Reference Front End; 11
; Bound: 43
; Schema: 0
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %4 "main" %11
OpExecutionMode %4 LocalSize 64 1 1
OpSource GLSL 450
OpName %4 "main"
OpName %11 "gl_GlobalInvocationID"
OpName %19 "O"
OpMemberName %19 0 "o"
OpName %21 "outb"
OpName %28 "tex"
OpDecorate %11 BuiltIn GlobalInvocationId
OpDecorate %18 ArrayStride 16
OpDecorate %19 Block
OpMemberDecorate %19 0 Offset 0
